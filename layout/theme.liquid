<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary | default: '#223A5F' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'vidhyut-logo-official.png' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <!-- Vidhyut Saathi Theme Core Styles -->
    {{ 'vidhyut-theme.css' | asset_url | stylesheet_tag }}
    {{ 'vidhyut-header.css' | asset_url | stylesheet_tag }}
    {{ 'vidhyut-hero-carousel.css' | asset_url | stylesheet_tag }}
    {{ 'vidhyut-products.css' | asset_url | stylesheet_tag }}
    {{ 'vidhyut-about-intro.css' | asset_url | stylesheet_tag }}
    {{ 'vidhyut-why-choose.css' | asset_url | stylesheet_tag }}
    {{ 'vidhyut-distributorship.css' | asset_url | stylesheet_tag }}
    {{ 'vidhyut-secondary-cta.css' | asset_url | stylesheet_tag }}
    {{ 'vidhyut-about-page.css' | asset_url | stylesheet_tag }}
    {{ 'vidhyut-contact-page.css' | asset_url | stylesheet_tag }}
    {{ 'vidhyut-collection-gallery.css' | asset_url | stylesheet_tag }}
    {{ 'vidhyut-cart.css' | asset_url | stylesheet_tag }}
    {{ 'vidhyut-footer.css' | asset_url | stylesheet_tag }}
    {{ 'vidhyut-policy-modal.css' | asset_url | stylesheet_tag }}

    <!-- Anti-FOUC Drawer Isolation & Viewport Overflow Protection -->
    <style>
      html,
      body {
        overflow-x: hidden !important;
        width: 100% !important;
        max-width: 100% !important;
        overscroll-behavior-x: none !important;
        position: relative !important;
      }
      #MainContent,
      main.content-for-layout {
        overflow-x: hidden !important;
        width: 100% !important;
        max-width: 100% !important;
        position: relative !important;
      }
      .vs-cart-drawer:not(.is-open),
      .vs-mobile-drawer:not(.is-open),
      .vs-cart-drawer-backdrop:not(.is-open),
      .vs-nav-backdrop:not(.is-open),
      .vs-mobile-drawer-backdrop:not(.is-open) {
        display: none !important;
        visibility: hidden !important;
        pointer-events: none !important;
        opacity: 0 !important;
        transform: translateX(100%) !important;
      }
      .vs-mobile-drawer:not(.is-open) {
        transform: translateX(-100%) !important;
      }
      .vs-cart-drawer.is-open,
      .vs-mobile-drawer.is-open {
        display: flex !important;
        visibility: visible !important;
        pointer-events: auto !important;
        opacity: 1 !important;
        transform: translateX(0) !important;
      }
      .vs-cart-drawer-backdrop.is-open,
      .vs-nav-backdrop.is-open,
      .vs-mobile-drawer-backdrop.is-open {
        display: block !important;
        visibility: visible !important;
        pointer-events: auto !important;
        opacity: 1 !important;
      }
    </style>

    <!-- Product Asset CDN Map for Cart & Dynamic Components -->
    <script>
      window.VidhyutThemeAssets = {
        'solar-lights.jpg': {{ 'solar-lights.jpg' | asset_url | json }},
        'solar-lights-1.jpg': {{ 'solar-lights-1.jpg' | asset_url | json }},
        'solar-led-lamps-1.jpg': {{ 'solar-led-lamps-1.jpg' | asset_url | json }},
        'solar-led-lamps-2.jpg': {{ 'solar-led-lamps-2.jpg' | asset_url | json }},
        'solar-led-lamps-3.jpg': {{ 'solar-led-lamps-3.jpg' | asset_url | json }},
        'solar-led-lamps-4.jpg': {{ 'solar-led-lamps-4.jpg' | asset_url | json }},
        'led-lamps.jpg': {{ 'led-lamps.jpg' | asset_url | json }},
        'led-bulbs.jpg': {{ 'led-bulbs.jpg' | asset_url | json }},
        'led-bulb-1.jpg': {{ 'led-bulb-1.jpg' | asset_url | json }},
        'led-bulb-2.jpg': {{ 'led-bulb-2.jpg' | asset_url | json }},
        'led-bulb-3.jpg': {{ 'led-bulb-3.jpg' | asset_url | json }},
        'led-bulb-4.jpg': {{ 'led-bulb-4.jpg' | asset_url | json }},
        'clamp-meters.jpg': {{ 'clamp-meters.jpg' | asset_url | json }},
        'clamp-meter-1.jpg': {{ 'clamp-meter-1.jpg' | asset_url | json }},
        'clamp-meter-2.jpg': {{ 'clamp-meter-2.jpg' | asset_url | json }},
        'clamp-meter-3.jpg': {{ 'clamp-meter-3.jpg' | asset_url | json }},
        'clamp-meter-4.jpg': {{ 'clamp-meter-4.jpg' | asset_url | json }},
        'vidhyut-power-saver-card.jpg': {{ 'vidhyut-power-saver-card.jpg' | asset_url | json }},
        'vidhyut-logo-official.png': {{ 'vidhyut-logo-official.png' | asset_url | json }}
      };
    </script>

    <!-- Scripts -->
    <script src="{{ 'vidhyut-carousel.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'vidhyut-mobile-nav.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'vidhyut-contact-page.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'vidhyut-distributorship.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'vidhyut-cart.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'vidhyut-theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'vidhyut-policy-modal.js' | asset_url }}?v={{ 'now' | date: '%s' }}" defer="defer"></script>
  </head>

  <body class="template-{{ template.name | handle }} vidhyut-saathi-theme">
    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
