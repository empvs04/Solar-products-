<section class="vs-payment-soon-section">
  <style>
    .vs-payment-soon-section {
      padding: clamp(3rem, 6vw, 5.5rem) 0;
      background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
      min-height: calc(100vh - 280px);
      display: flex;
      align-items: center;
      width: 100%;
      box-sizing: border-box;
    }

    .vs-payment-card {
      max-width: 760px;
      margin: 0 auto;
      background: #FFFFFF;
      border: 1px solid rgba(226, 232, 240, 0.9);
      border-radius: 24px;
      box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08), 0 4px 12px rgba(15, 23, 42, 0.03);
      padding: clamp(2rem, 4vw, 3.25rem);
      text-align: center;
      position: relative;
      overflow: hidden;
      width: 100%;
      box-sizing: border-box;
    }

    .vs-payment-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #E86014 0%, #F59E0B 50%, #10B981 100%);
    }

    .vs-payment-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      border-radius: 9999px;
      background: #FEF3C7;
      border: 1px solid #FCD34D;
      color: #92400E;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin-bottom: 1.5rem;
    }

    .vs-payment-icon-wrap {
      width: 90px;
      height: 90px;
      margin: 0 auto 1.5rem auto;
      border-radius: 50%;
      background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%);
      border: 2px solid #FDBA74;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #E86014;
      box-shadow: 0 10px 25px rgba(232, 96, 20, 0.18);
      position: relative;
    }

    .vs-payment-title {
      font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
      font-size: clamp(1.8rem, 3.5vw, 2.5rem);
      font-weight: 800;
      color: #0F172A;
      margin: 0 0 1rem 0;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }

    .vs-payment-desc {
      font-size: clamp(0.95rem, 1.8vw, 1.05rem);
      color: #475569;
      line-height: 1.7;
      max-width: 620px;
      margin: 0 auto 2rem auto;
    }

    .vs-order-summary-box {
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 16px;
      padding: 1.25rem 1.5rem;
      margin: 0 auto 2rem auto;
      text-align: left;
    }

    .vs-order-summary-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #E2E8F0;
      padding-bottom: 0.75rem;
      margin-bottom: 0.875rem;
    }

    .vs-order-summary-head h3 {
      font-size: 0.95rem;
      font-weight: 700;
      color: #0F172A;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .vs-order-item-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 0;
      font-size: 0.9rem;
      color: #334155;
    }

    .vs-order-item-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .vs-order-item-qty {
      background: #E2E8F0;
      color: #475569;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 6px;
    }

    .vs-order-total-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px dashed #CBD5E1;
      padding-top: 0.875rem;
      margin-top: 0.875rem;
      font-weight: 800;
      font-size: 1.05rem;
      color: #0F172A;
    }

    .vs-order-total-val {
      color: #E86014;
      font-size: 1.25rem;
    }

    .vs-payment-actions {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }

    .vs-payment-btn-primary {
      background: #E86014;
      color: #FFFFFF;
      padding: 0.875rem 1.75rem;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 4px 14px rgba(232, 96, 20, 0.35);
      transition: all 0.2s ease;
      border: none;
      cursor: pointer;
    }

    .vs-payment-btn-primary:hover {
      background: #d0530e;
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(232, 96, 20, 0.45);
    }

    .vs-payment-btn-secondary {
      background: #FFFFFF;
      color: #0F172A;
      border: 1.5px solid #CBD5E1;
      padding: 0.875rem 1.5rem;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .vs-payment-btn-secondary:hover {
      border-color: #94A3B8;
      background: #F8FAFC;
    }

    .vs-payment-btn-call {
      background: #223A5F;
      color: #FFFFFF;
      padding: 0.875rem 1.5rem;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .vs-payment-btn-call:hover {
      background: #182B46;
      transform: translateY(-2px);
    }

    .vs-trust-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      border-top: 1px solid #E2E8F0;
      padding-top: 1.75rem;
      margin-top: 1rem;
    }

    .vs-trust-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      font-size: 0.78rem;
      font-weight: 600;
      color: #64748B;
    }

    .vs-trust-item svg {
      color: #10B981;
    }

    @media (max-width: 640px) {
      .vs-trust-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
      }
      .vs-payment-actions {
        flex-direction: column;
      }
      .vs-payment-actions a,
      .vs-payment-actions button {
        width: 100%;
        justify-content: center;
      }
    }
  </style>

  <div class="vs-container" style="max-width: 1200px; margin: 0 auto; padding: 0 20px; width: 100%; box-sizing: border-box;">
    <div class="vs-payment-card">
      
      <!-- Badge -->
      <div class="vs-payment-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        <span>{{ section.settings.badge | default: 'Direct Payment Gateway Integration' }}</span>
      </div>

      <!-- Glowing Icon -->
      <div class="vs-payment-icon-wrap">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
      </div>

      <!-- Primary Heading -->
      <h1 class="vs-payment-title">{{ section.settings.heading | default: 'Payment Gateway is Coming Soon' }}</h1>

      <!-- Explanatory Description -->
      <p class="vs-payment-desc">
        {{ section.settings.subheading | default: 'We are currently integrating an official, 100% secure online payment gateway (UPI, Credit/Debit Cards, Net Banking & EMI) to bring you a seamless digital checkout experience. Direct online payments will be live shortly.' }}
      </p>

      <!-- Order Summary Preview Box (Loaded via JS) -->
      <div class="vs-order-summary-box" id="orderPreviewBox">
        <div class="vs-order-summary-head">
          <h3>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
            <span>Items Saved in Your Cart</span>
          </h3>
          <span style="font-size: 0.8rem; color: #10B981; font-weight: 700; background: #D1FAE5; padding: 2px 8px; border-radius: 6px;">✓ Preserved in Cart</span>
        </div>
        <div id="orderItemsList">
          <!-- Dynamically populated via script -->
        </div>
        <div class="vs-order-total-row">
          <span>Total Payable Amount</span>
          <span class="vs-order-total-val" id="orderTotalVal">₹0</span>
        </div>
      </div>

      <!-- Action CTAs -->
      <div class="vs-payment-actions">
        <a href="/pages/products" class="vs-payment-btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
          <span>Continue Shopping</span>
        </a>

        <button type="button" class="vs-payment-btn-secondary" id="viewCartDrawerBtn" onclick="window.vsCart && window.vsCart.openDrawer && window.vsCart.openDrawer();">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          <span>View / Edit Cart</span>
        </button>

        {% if section.settings.contact_phone != blank %}
        <a href="tel:{{ section.settings.contact_phone | replace: ' ', '' }}" class="vs-payment-btn-call">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <span>Order via Sales Desk</span>
        </a>
        {% endif %}
      </div>

      <!-- Trust Badges Strip -->
      <div class="vs-trust-grid">
        <div class="vs-trust-item">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          <span>256-Bit SSL Security</span>
        </div>
        <div class="vs-trust-item">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <span>Brand Warranty</span>
        </div>
        <div class="vs-trust-item">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          <span>GST Invoiced</span>
        </div>
        <div class="vs-trust-item">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          <span>Safe Delivery</span>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    try {
      var rawCart = localStorage.getItem('vs_cart');
      var cart = rawCart ? JSON.parse(rawCart) : [];
      var listContainer = document.getElementById('orderItemsList');
      var totalEl = document.getElementById('orderTotalVal');

      if (cart && cart.length > 0) {
        var html = '';
        var grandTotal = 0;
        cart.forEach(function(item) {
          var lineTotal = (item.price || 0) * (item.quantity || 1);
          grandTotal += lineTotal;
          html += '<div class="vs-order-item-row">';
          html += '  <div class="vs-order-item-info">';
          html += '    <span class="vs-order-item-qty">' + (item.quantity || 1) + 'x</span>';
          html += '    <span><strong>' + (item.name || 'Product') + '</strong>' + (item.variantName ? ' (' + item.variantName + ')' : '') + '</span>';
          html += '  </div>';
          html += '  <span>₹' + lineTotal.toLocaleString('en-IN') + '</span>';
          html += '</div>';
        });
        if (listContainer) listContainer.innerHTML = html;
        if (totalEl) totalEl.textContent = '₹' + grandTotal.toLocaleString('en-IN');
      } else {
        if (listContainer) {
          listContainer.innerHTML = '<p style="color: #64748B; font-size: 0.9rem; margin: 8px 0;">No active items in cart currently.</p>';
        }
        if (totalEl) totalEl.textContent = '₹0';
      }
    } catch (err) {
      console.error('Error rendering order preview:', err);
    }
  });
</script>

{% schema %}
{
  "name": "Payment Coming Soon",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Top Badge",
      "default": "Direct Payment Gateway Integration"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Payment Gateway is Coming Soon"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description",
      "default": "We are currently integrating an official, 100% secure online payment gateway (UPI, Credit/Debit Cards, Net Banking & EMI) to bring you a seamless digital checkout experience. Direct online payments will be live shortly."
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Sales Contact Phone",
      "default": "+91-8199036060"
    }
  ],
  "presets": [
    {
      "name": "Payment Gateway Coming Soon"
    }
  ]
}
{% endschema %}
