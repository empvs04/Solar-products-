{{ 'vidhyut-buy-now.css' | asset_url | stylesheet_tag }}

<main class="vs-buynow-page" id="buyNowSection">
  <!-- Enterprise Store Hero Banner -->
  <section class="vs-buynow-intro">
    <div class="vs-buynow-intro-grid-bg" aria-hidden="true"></div>
    <div class="vs-container">
      <div class="vs-buynow-intro-inner">
        <nav class="vs-buynow-breadcrumb" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span aria-hidden="true">/</span>
          <span>Direct Brand Store</span>
        </nav>
        <div class="vs-buynow-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          <span>{{ section.settings.badge | default: 'Direct Brand Store' }}</span>
        </div>
        <h1 class="vs-buynow-title">{{ section.settings.heading | default: 'Enterprise Store & Checkout' }}</h1>
        <p class="vs-buynow-subtitle">
          {{ section.settings.subheading | default: 'Configure genuine Vidhyut Saathi solar luminaires, power savers, and precision testing instruments with instant PhonePe, UPI & card checkout.' }}
        </p>
        <div class="vs-buynow-hero-metrics">
          <div class="vs-hero-metric-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <span>1-Year Brand Warranty</span>
          </div>
          <div class="vs-hero-metric-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><rect x="1" y="4" width="22" height="16" rx="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
            <span>PhonePe, UPI &amp; Cards</span>
          </div>
          <div class="vs-hero-metric-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
            <span>18% GST Tax Invoice</span>
          </div>
          <div class="vs-hero-metric-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            <span>Free Pan-India Dispatch</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       Dedicated Shared Cart Review Section
       ====================================================================== -->
  <section class="vs-cart-review-section" id="cartReviewSection">
    <div class="vs-container">
      <div class="vs-cart-review-header-wrap">
        <div class="vs-cart-page-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          <span>Review Your Order</span>
        </div>
        <h2 class="vs-cart-page-title">Shopping Cart &amp; Summary</h2>
        <p class="vs-cart-page-subtitle">
          Adjust quantities, apply coupon codes, or add optional GSTIN details before continuing to secure PhonePe &amp; UPI checkout.
        </p>
      </div>

      <div id="dedicatedCartReviewSection">
        <!-- Populated by VidhyutCart -->
      </div>
    </div>
  </section>

  <div class="vs-container">
    <!-- Category Quick Switcher Tabs -->
    <section class="vs-buynow-selector-wrap" aria-label="Product Category Selector">
      <div class="vs-category-tabs">
        <div class="vs-category-tab" data-product-id="vidhyut-saver-card">
          <img src="{{ 'vidhyut-power-saver-card.jpg' | asset_url }}" alt="Best Sellers" class="vs-cat-thumb" width="44" height="44" loading="lazy">
          <div class="vs-cat-info">
            <span class="vs-cat-name">Best Sellers</span>
            <span class="vs-cat-badge">Saver Card &amp; Meco</span>
          </div>
        </div>
        <div class="vs-category-tab is-active" data-product-id="solar-lights">
          <img src="{{ 'solar-lights.jpg' | asset_url }}" alt="Solar Lights" class="vs-cat-thumb" width="44" height="44" loading="lazy">
          <div class="vs-cat-info">
            <span class="vs-cat-name">Solar Lights</span>
            <span class="vs-cat-badge">Solar Solutions</span>
          </div>
        </div>
        <div class="vs-category-tab" data-product-id="led-lamps">
          <img src="{{ 'led-lamps.jpg' | asset_url }}" alt="LED Lamps" class="vs-cat-thumb" width="44" height="44" loading="lazy">
          <div class="vs-cat-info">
            <span class="vs-cat-name">LED Lamps</span>
            <span class="vs-cat-badge">Commercial &amp; Indoor</span>
          </div>
        </div>
        <div class="vs-category-tab" data-product-id="led-bulbs">
          <img src="{{ 'led-bulbs.jpg' | asset_url }}" alt="LED Bulbs" class="vs-cat-thumb" width="44" height="44" loading="lazy">
          <div class="vs-cat-info">
            <span class="vs-cat-name">LED Bulbs</span>
            <span class="vs-cat-badge">Energy Saving</span>
          </div>
        </div>
        <div class="vs-category-tab" data-product-id="clamp-meters">
          <img src="{{ 'clamp-meters.jpg' | asset_url }}" alt="Clamp Meters" class="vs-cat-thumb" width="44" height="44" loading="lazy">
          <div class="vs-cat-info">
            <span class="vs-cat-name">Clamp Meters</span>
            <span class="vs-cat-badge">Electrical Testing</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Selected Product Showcase -->
    <section class="vs-product-showcase" id="productShowcase" aria-labelledby="productName">
      <div class="vs-showcase-grid">
        
        <!-- Media Column -->
        <div class="vs-showcase-media">
          <div class="vs-main-img-card" id="mainImgCard">
            <span class="vs-media-badge" id="mediaCategoryBadge">Solar Solutions</span>
            <span class="vs-media-genuine-pill">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Official Brand Product</span>
            </span>
            <img
              src="{{ 'solar-lights.jpg' | asset_url }}"
              alt="Selected Product"
              id="mainProductImg"
              class="vs-main-product-img"
              width="600"
              height="600"
            >
            <button type="button" class="vs-zoom-toggle-btn" id="imgZoomToggle" aria-label="Toggle product image zoom">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
              <span>Zoom</span>
            </button>
          </div>

          <!-- Dispatch & Delivery Estimator -->
          <div class="vs-dispatch-estimator">
            <div class="vs-dispatch-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            </div>
            <div class="vs-dispatch-copy">
              <strong>Express Dispatch from Rohtak, Haryana</strong>
              <span>Order today for priority dispatch &bull; Free Pan-India Delivery (3&ndash;5 business days)</span>
            </div>
          </div>

          <!-- Trust Badges -->
          <div class="vs-trust-grid">
            <div class="vs-trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>100% Genuine Quality</span>
            </div>
            <div class="vs-trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M3 21v-5h5"></path></svg>
              <span>7-Days Easy Replacement</span>
            </div>
            <div class="vs-trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
              <span>GST Tax Invoice Included</span>
            </div>
            <div class="vs-trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <span>Direct Technical Support</span>
            </div>
          </div>
        </div>

        <!-- Purchasing Details Column -->
        <div class="vs-showcase-details">
          <div class="vs-details-meta">
            <span class="vs-meta-category" id="productMetaCategory">Solar Solutions</span>
            <span class="vs-stock-badge">
              <span class="vs-stock-dot"></span>
              <span id="productStockBadge">In Stock - Dispatch within 24h</span>
            </span>
            <span class="vs-rating-pill" id="productRatingPill">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              <span>4.9 (128+ Verified)</span>
            </span>
          </div>

          <h2 class="vs-product-name" id="productName">Solar Lights</h2>

          <!-- Price Area -->
          <div class="vs-price-box">
            <div class="vs-price-top-line">
              <span class="vs-price-current" id="priceCurrent">₹2,499</span>
              <span class="vs-price-original" id="priceOriginal">₹3,200</span>
              <span class="vs-price-discount" id="priceDiscount">22% OFF</span>
              <span class="vs-price-savings-chip" id="priceSavingsChip">Save ₹701</span>
            </div>
            <div class="vs-price-note">
              ✓ Inclusive of 18% GST &bull; Free standard shipping across India &bull; B2B GST invoice available
            </div>
          </div>

          <p class="vs-details-desc" id="productDesc">
            All-in-one solar luminaires and street lighting with integrated PV panels, lithium storage, and dusk-to-dawn sensors for autonomous outdoor illumination.
          </p>

          <!-- Variants Selection -->
          <div class="vs-option-group">
            <div class="vs-option-header">
              <span class="vs-option-title">Select Model / Configuration</span>
              <span class="vs-option-selected-label" id="selectedVariantLabel">30W Standard Street Light</span>
            </div>
            <div class="vs-variant-cards" id="variantCardsWrap">
              <!-- Dynamically populated via vidhyut-buy-now.js -->
            </div>
          </div>

          <!-- Quantity & Subtotal Row -->
          <div class="vs-qty-subtotal-row">
            <div class="vs-qty-wrap">
              <span class="vs-qty-label">Quantity:</span>
              <div class="vs-qty-picker">
                <button type="button" class="vs-qty-btn" id="qtyDec" aria-label="Decrease quantity">&minus;</button>
                <input type="number" id="qtyInput" class="vs-qty-input" value="1" min="1" max="99" aria-label="Product quantity">
                <button type="button" class="vs-qty-btn" id="qtyInc" aria-label="Increase quantity">&plus;</button>
              </div>
            </div>
            <div class="vs-subtotal-display">
              <div class="vs-subtotal-label">Order Total (Incl. GST)</div>
              <div class="vs-subtotal-val" id="subtotalVal">₹2,499</div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="vs-action-buttons">
            <button type="button" class="vs-btn-cart" id="addToCartBtn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              <span>Add to Cart</span>
            </button>
            <button type="button" class="vs-btn-checkout" id="buyNowDirectBtn">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
              <span>Buy Now &mdash; PhonePe / UPI</span>
            </button>
          </div>

          <!-- Payment Acceptance Strip -->
          <div class="vs-pdp-payment-strip">
            <span class="vs-pdp-payment-label">100% Secure Checkout powered by Shopify &amp; PhonePe</span>
            <img
              src="{{ 'payment-trust-badges.png' | asset_url }}"
              alt="PhonePe, Google Pay, Paytm, Visa, RuPay, Mastercard Accepted"
              class="vs-pdp-payment-badges"
              width="292"
              height="24"
              loading="lazy"
            >
          </div>

          <!-- Direct Sales / Commercial Inquiry Snippet -->
          <div class="vs-direct-inquiry">
            <span>Need bulk commercial pricing (10+ units) or distributorship rates?</span>
            <a href="tel:{{ section.settings.contact_phone | default: '+918199036060' }}" class="vs-inquiry-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <span>Call Sales Desk: {{ section.settings.contact_phone | default: '+91-8199036060' }}</span>
            </a>
          </div>

          <!-- Interactive Product Details Tabs -->
          <div class="vs-specs-section">
            <div class="vs-detail-tabs" role="tablist" aria-label="Product Information">
              <button type="button" class="vs-detail-tab is-active" data-detail-tab="specs" role="tab" aria-selected="true">Technical Specs</button>
              <button type="button" class="vs-detail-tab" data-detail-tab="warranty" role="tab" aria-selected="false">Warranty &amp; Box</button>
              <button type="button" class="vs-detail-tab" data-detail-tab="shipping" role="tab" aria-selected="false">Shipping &amp; GST</button>
            </div>

            <div class="vs-detail-panel is-active" id="detailPanelSpecs">
              <table class="vs-specs-table">
                <tbody id="specsTableBody">
                  <!-- Dynamically populated via vidhyut-buy-now.js -->
                </tbody>
              </table>
            </div>

            <div class="vs-detail-panel" id="detailPanelWarranty" style="display: none;">
              <ul class="vs-detail-list">
                <li><strong>1 Year Official Brand Warranty</strong> covering manufacturing &amp; driver defects across India.</li>
                <li><strong>Quality-Checked Packaging:</strong> Factory-tested unit, mounting/test accessories (where applicable), and user documentation.</li>
                <li><strong>7-Day Replacement Guarantee</strong> for transit damage or functional DOA issues reported with unboxing video.</li>
              </ul>
            </div>

            <div class="vs-detail-panel" id="detailPanelShipping" style="display: none;">
              <ul class="vs-detail-list">
                <li><strong>Free Pan-India Standard Delivery</strong> dispatched within 24 business hours from Rohtak, Haryana.</li>
                <li><strong>18% GST Tax Invoice</strong> generated automatically &mdash; enter your company GSTIN in the cart for B2B input tax credit.</li>
                <li><strong>Instant Payment Modes:</strong> PhonePe, Google Pay, Paytm, UPI Intent, Credit/Debit Cards, and Net Banking.</li>
              </ul>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Explore More Products Recommendations -->
    <section class="vs-recommendations" aria-labelledby="recHeading">
      <div class="vs-rec-top-bar">
        <div class="vs-rec-header">
          <span class="vs-rec-badge">Complete Catalogue</span>
          <h2 class="vs-rec-title" id="recHeading">Explore All Products</h2>
        </div>
        <div class="vs-rec-search-wrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="search" id="recSearchInput" class="vs-rec-search-input" placeholder="Search solar lights, clamp meters, saver card..." aria-label="Search Vidhyut Saathi products">
        </div>
      </div>

      <div class="vs-rec-filter-pills" id="recFilterPills" role="group" aria-label="Filter products by category">
        <button type="button" class="vs-rec-filter-btn is-active" data-rec-filter="all">All Products</button>
        <button type="button" class="vs-rec-filter-btn" data-rec-filter="best-sellers">Best Sellers</button>
        <button type="button" class="vs-rec-filter-btn" data-rec-filter="solar-lights">Solar Lights</button>
        <button type="button" class="vs-rec-filter-btn" data-rec-filter="led-lamps">LED Lamps</button>
        <button type="button" class="vs-rec-filter-btn" data-rec-filter="led-bulbs">LED Bulbs</button>
        <button type="button" class="vs-rec-filter-btn" data-rec-filter="clamp-meters">Clamp Meters</button>
      </div>

      <div class="vs-rec-grid" id="recGrid">
        <!-- Dynamically populated via vidhyut-buy-now.js -->
      </div>
    </section>
  </div>
</main>

<script src="{{ 'vidhyut-buy-now.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Buy Now Page",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Header Badge",
      "default": "Direct Brand Store"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Enterprise Store & Checkout"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Configure genuine Vidhyut Saathi solar luminaires, power savers, and precision testing instruments with instant PhonePe, UPI & card checkout."
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Sales Contact Phone",
      "default": "+91-8199036060"
    }
  ],
  "presets": [
    {
      "name": "Vidhyut Buy Now Showcase"
    }
  ]
}
{% endschema %}
