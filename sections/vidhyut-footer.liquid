
<style>
  .vs-footer-bottom {
    color: #ffffff !important;
  }
  .vs-footer-copy {
    color: #ffffff !important;
    font-weight: 500 !important;
    opacity: 1 !important;
  }
  .vs-footer-bottom-link {
    color: #cbd5e1 !important;
    transition: color 0.2s ease !important;
  }
  .vs-footer-bottom-link:hover {
    color: #ff5700 !important;
    text-decoration: underline !important;
  }
  .vs-footer-dot {
    color: #64748b !important;
  }
</style>

<footer class="vs-footer" id="contact">
  <div class="vs-container">
    <div class="vs-footer-grid">

      <!-- Column 1: Brand -->
      <div class="vs-footer-brand-col">
        <a href="{{ routes.root_url }}" class="vs-footer-logo-link" aria-label="Vidhyut Saathi Home">
          {% if section.settings.logo != blank %}
            <img
              src="{{ section.settings.logo | image_url: width: 120 }}"
              alt="{{ shop.name | escape }}"
              class="vs-footer-logo-img"
              width="42"
              height="42"
            >
          {% else %}
            <img
              src="{{ 'vidhyut-logo-official.png' | asset_url }}"
              alt="Vidhyut Saathi Official Logo"
              class="vs-footer-logo-img"
              width="42"
              height="42"
            >
          {% endif %}
          <div>
            <div class="vs-footer-brand-name">{{ section.settings.brand_name | default: 'Vidhyut Saathi' }}</div>
            <div class="vs-footer-brand-tagline">{{ section.settings.tagline | default: 'Solar & Electrical' }}</div>
          </div>
        </a>
        <p class="vs-footer-brand-desc">
          {{ section.settings.description | default: 'Vidhyut Saathi is an Indian electrical and solar products brand committed to dependable solar lighting, energy-efficient luminaires, and precision measurement equipment.' }}
        </p>
      </div>

      <!-- Column 2: Navigation Links -->
      <div class="vs-footer-col">
        <h3 class="vs-footer-col-title">Navigation</h3>
        {%- liquid
          assign base_root = routes.root_url
          if base_root == '/'
            assign base_root = ''
          endif

          if section.settings.contact_link != blank
            assign footer_contact_url = section.settings.contact_link
          elsif pages['contact-us'].url != blank
            assign footer_contact_url = pages['contact-us'].url
          elsif pages['contact'].url != blank
            assign footer_contact_url = pages['contact'].url
          else
            assign footer_contact_url = base_root | append: '/pages/contact-us'
          endif

          if section.settings.about_link != blank
            assign footer_about_url = section.settings.about_link
          elsif pages['about-us'].url != blank
            assign footer_about_url = pages['about-us'].url
          elsif pages['about'].url != blank
            assign footer_about_url = pages['about'].url
          else
            assign footer_about_url = base_root | append: '/pages/about-us'
          endif

          if pages['buy-distributorship'].url != blank
            assign footer_distributor_url = pages['buy-distributorship'].url
          elsif pages['distributorship'].url != blank
            assign footer_distributor_url = pages['distributorship'].url
          elsif pages['get-franchise'].url != blank
            assign footer_distributor_url = pages['get-franchise'].url
          else
            assign footer_distributor_url = base_root | append: '/pages/buy-distributorship'
          endif

          if pages['products'].url != blank
            assign footer_products_url = pages['products'].url
          elsif pages['our-products'].url != blank
            assign footer_products_url = pages['our-products'].url
          elsif routes.all_products_collection_url != blank
            assign footer_products_url = routes.all_products_collection_url
          else
            assign footer_products_url = base_root | append: '/pages/products'
          endif

          if pages['buy-now'].url != blank
            assign footer_buy_now_url = pages['buy-now'].url
          elsif pages['buynow'].url != blank
            assign footer_buy_now_url = pages['buynow'].url
          else
            assign footer_buy_now_url = base_root | append: '/pages/buy-now'
          endif
        -%}

        <ul class="vs-footer-links-list">
          <li><a href="{{ routes.root_url }}" class="vs-footer-link">Home</a></li>
          <li><a href="{{ footer_about_url }}" class="vs-footer-link">About Us</a></li>
          <li><a href="{{ footer_products_url }}" class="vs-footer-link">Products</a></li>
          <li><a href="{{ footer_contact_url }}" class="vs-footer-link">Contact Us</a></li>
        </ul>
      </div>

      <!-- Column 3: Product Links -->
      <div class="vs-footer-col">
        <h3 class="vs-footer-col-title">Products</h3>
        <ul class="vs-footer-links-list">
          <li><a href="{{ routes.root_url }}#products-solar-lights" class="vs-footer-link">Solar Lights</a></li>
          <li><a href="{{ routes.root_url }}#products-led-lamps" class="vs-footer-link">LED Lamps</a></li>
          <li><a href="{{ routes.root_url }}#products-led-bulbs" class="vs-footer-link">LED Bulbs</a></li>
          <li><a href="{{ routes.root_url }}#products-clamp-meters" class="vs-footer-link">Clamp Meters</a></li>
        </ul>
      </div>

      <!-- Column 4: Business Links -->
      <div class="vs-footer-col">
        <h3 class="vs-footer-col-title">Business</h3>
        <ul class="vs-footer-links-list">
          <li><a href="{{ footer_buy_now_url }}" class="vs-footer-link">Buy Now</a></li>
          <li><a href="{{ footer_distributor_url }}" class="vs-footer-link">Buy Distributorship</a></li>
          <li><a href="{{ footer_contact_url }}" class="vs-footer-link">Partner Inquiries</a></li>
          <li><a href="{{ footer_about_url }}" class="vs-footer-link">Company Overview</a></li>
        </ul>
      </div>

      <!-- Column 5: Contact Information -->
      <div class="vs-footer-col">
        <h3 class="vs-footer-col-title">Contact Us</h3>
        <div class="vs-footer-contact-list">
          <div class="vs-footer-contact-item">
            <svg class="vs-footer-contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>{{ section.settings.address | default: 'SCO-77A, 3rd Floor, Ashoka Complex, Delhi Road, Rohtak - 124001, Haryana, India' }}</span>
          </div>
          <div class="vs-footer-contact-item">
            <svg class="vs-footer-contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <a href="mailto:{{ section.settings.email | default: 'info@vidhyutsaathi.com' }}">{{ section.settings.email | default: 'info@vidhyutsaathi.com' }}</a>
          </div>
          <div class="vs-footer-contact-item">
            <svg class="vs-footer-contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <div>
              <a href="tel:{{ section.settings.phone_1 | default: '+918199036060' }}">{{ section.settings.phone_1 | default: '+91-8199036060' }}</a><br>
              <a href="tel:{{ section.settings.phone_2 | default: '+919053110707' }}">{{ section.settings.phone_2 | default: '+91-9053110707' }}</a>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Footer Bottom -->
    <div class="vs-footer-bottom">
      <p class="vs-footer-copy" style="color: #ffffff !important; font-weight: 500; font-size: 0.875rem; letter-spacing: 0.2px;">
        &copy; copyright 2022-2026. All Rights Reserved Vidhyut Saathi Energy Savings Private Limited
      </p>
      <div class="vs-footer-bottom-links">
        {% assign privacy_url_val = '/pages/privacy-policy' %}
        {% if pages['privacy-policy'].url != blank %}
          {% assign privacy_url_val = pages['privacy-policy'].url %}
        {% elsif pages['privacy'].url != blank %}
          {% assign privacy_url_val = pages['privacy'].url %}
        {% endif %}
        <a href="{{ section.settings.privacy_policy_url | default: privacy_url_val }}" class="vs-footer-bottom-link">Privacy Policy</a>
        <span class="vs-footer-dot" aria-hidden="true">•</span>

        {% assign disclaimer_url_val = '/pages/disclaimer' %}
        {% if pages['disclaimer'].url != blank %}
          {% assign disclaimer_url_val = pages['disclaimer'].url %}
        {% endif %}
        <a href="{{ section.settings.disclaimer_url | default: disclaimer_url_val }}" class="vs-footer-bottom-link">Disclaimer</a>
        <span class="vs-footer-dot" aria-hidden="true">•</span>

        {% assign terms_url_val = '/pages/terms-conditions' %}
        {% if pages['terms-conditions'].url != blank %}
          {% assign terms_url_val = pages['terms-conditions'].url %}
        {% elsif pages['terms-and-conditions'].url != blank %}
          {% assign terms_url_val = pages['terms-and-conditions'].url %}
        {% elsif pages['terms'].url != blank %}
          {% assign terms_url_val = pages['terms'].url %}
        {% endif %}
        <a href="{{ section.settings.terms_url | default: terms_url_val }}" class="vs-footer-bottom-link">Terms &amp; Conditions</a>
        <span class="vs-footer-dot" aria-hidden="true">•</span>

        {% assign return_refund_url = '/pages/return' %}
        {% if pages['return'].url != blank %}
          {% assign return_refund_url = pages['return'].url %}
        {% elsif pages['refund-policy'].url != blank %}
          {% assign return_refund_url = pages['refund-policy'].url %}
        {% elsif pages['return-refund'].url != blank %}
          {% assign return_refund_url = pages['return-refund'].url %}
        {% endif %}
        <a href="{{ section.settings.refund_url | default: return_refund_url }}" class="vs-footer-bottom-link">Return &amp; Refund Policy</a>
        <span class="vs-footer-dot" aria-hidden="true">•</span>
        <a href="{{ footer_contact_url }}" class="vs-footer-bottom-link">Support</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Corporate Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Vidhyut Saathi"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Solar & Electrical"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Brand Description",
      "default": "Vidhyut Saathi is an Indian electrical and solar products brand committed to dependable solar lighting, energy-efficient luminaires, and precision measurement equipment."
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Headquarters Address",
      "default": "SCO-77A, 3rd Floor, Ashoka Complex, Delhi Road, Rohtak - 124001, Haryana, India"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support Email",
      "default": "info@vidhyutsaathi.com"
    },
    {
      "type": "text",
      "id": "phone_1",
      "label": "Primary Phone",
      "default": "+91-8199036060"
    },
    {
      "type": "text",
      "id": "phone_2",
      "label": "Secondary Phone",
      "default": "+91-9053110707"
    },
    {
      "type": "url",
      "id": "about_link",
      "label": "About Us Page Link"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact Us Page Link"
    }
  ]
}
{% endschema %}
