{% schema %}
{
  "name": "Collection Gallery",
  "settings": [
    {
      "type": "text",
      "id": "category_handle",
      "label": "Category Handle (solar-lights, led-lamps, led-bulbs, clamp-meters)",
      "info": "Leave blank to detect automatically from page or collection URL"
    },
    {
      "type": "text",
      "id": "solar_title",
      "label": "Solar Lights Title",
      "default": "Solar Lights Collection"
    },
    {
      "type": "text",
      "id": "lamp_title",
      "label": "LED Lamps Title",
      "default": "LED Lamps Collection"
    },
    {
      "type": "text",
      "id": "bulb_title",
      "label": "LED Bulbs Title",
      "default": "LED Bulbs Collection"
    },
    {
      "type": "text",
      "id": "clamp_title",
      "label": "Clamp Meters Title",
      "default": "Digital Clamp Meters Collection"
    }
  ],
  "presets": [
    {
      "name": "Vidhyut Collection Gallery"
    }
  ]
}
{% endschema %}
