{{ 'vidhyut-collection-gallery.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_handle = collection.handle | default: 'solar-lights'
  if current_handle == 'all' or current_handle == blank
    assign current_handle = 'solar-lights'
  endif
-%}

<main class="vs-category-page" id="collectionGallery">
  <!-- Category Header Bar -->
  <div class="vs-category-header-wrap">
    <div class="vs-container">
      <div class="vs-breadcrumbs-bar">
        <nav class="vs-breadcrumbs" aria-label="Breadcrumb Navigation">
          <a href="{{ routes.root_url }}">Home</a>
          <span class="vs-breadcrumbs-sep">/</span>
          <a href="{{ routes.root_url }}#products">Products</a>
          <span class="vs-breadcrumbs-sep">/</span>
          <span class="vs-breadcrumbs-current">
            {%- case current_handle -%}
              {%- when 'solar-lights' -%}Solar Lights
              {%- when 'led-lamps' -%}LED Lamps
              {%- when 'led-bulbs' -%}LED Bulbs
              {%- when 'clamp-meters' -%}Clamp Meters
              {%- else -%}{{ collection.title | default: 'Products' }}
            {%- endcase -%}
          </span>
        </nav>
        <a href="{{ routes.root_url }}#products" class="vs-back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
          <span>Back to Products</span>
        </a>
      </div>

      <div class="vs-category-intro">
        <div class="vs-category-badge">
          {%- case current_handle -%}
            {%- when 'solar-lights' -%}Renewable Outdoor Lighting
            {%- when 'led-lamps' -%}Commercial & Emergency Lighting
            {%- when 'led-bulbs' -%}Energy Saving Solutions
            {%- when 'clamp-meters' -%}Precision Electrical Testing
            {%- else -%}Vidhyut Saathi Products
          {%- endcase -%}
        </div>
        <h1 class="vs-category-title">
          {%- case current_handle -%}
            {%- when 'solar-lights' -%}{{ section.settings.solar_title | default: 'Solar Lights Collection' }}
            {%- when 'led-lamps' -%}{{ section.settings.lamp_title | default: 'LED Lamps Collection' }}
            {%- when 'led-bulbs' -%}{{ section.settings.bulb_title | default: 'LED Bulbs Collection' }}
            {%- when 'clamp-meters' -%}{{ section.settings.clamp_title | default: 'Digital Clamp Meters Collection' }}
            {%- else -%}{{ collection.title | default: 'Product Collection' }}
          {%- endcase -%}
        </h1>
        <p class="vs-category-desc">
          {%- case current_handle -%}
            {%- when 'solar-lights' -%}
              Explore Vidhyut Saathi's autonomous solar illumination systems engineered for outdoor dependability, Indian weather resistance, and zero electricity costs.
            {%- when 'led-lamps' -%}
              Discover high-performance architectural luminaires, heavy-duty portable flood work lamps, and omni-directional emergency light towers designed for uniform, glare-free light.
            {%- when 'led-bulbs' -%}
              Explore high-efficacy, long-life LED bulbs and specialty DC/solar lamps engineered with thermal management and wide beam distribution.
            {%- when 'clamp-meters' -%}
              Explore rugged digital clamp multimeters and current testers offering True-RMS accuracy, CAT III safety ratings, and dependable electrical diagnostics.
            {%- else -%}
              Discover reliable solar lighting and electrical solutions from Vidhyut Saathi.
          {%- endcase -%}
        </p>
      </div>
    </div>
  </div>

  <!-- Product Gallery Grid -->
