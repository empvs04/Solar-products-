<section class="vs-products-section" id="products">
  <div class="vs-container">
    {% if section.settings.badge != blank or section.settings.title != blank or section.settings.subtitle != blank %}
      <header class="vs-section-header">
        {% if section.settings.badge != blank %}
          <div class="vs-section-badge">{{ section.settings.badge }}</div>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="vs-section-title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="vs-section-subtitle">
            {{ section.settings.subtitle }}
          </p>
        {% endif %}
      </header>
    {% endif %}
    {%- liquid
      assign base_root = routes.root_url
      if base_root == '/'
        assign base_root = ''
      endif
    -%}

    <div class="vs-products-grid">
      <!-- Card 1: Solar Lights -->
      <article class="vs-product-card" id="products-solar-lights">
        <div class="vs-product-image-wrap">
          <span class="vs-product-badge">Solar Solutions</span>
          <img
            src="{{ 'solar-lights.jpg' | asset_url }}"
            alt="Vidhyut Saathi all-in-one solar street light with integrated solar panel"
            class="vs-product-img"
            loading="lazy"
            width="600"
            height="600"
          >
        </div>
        <div class="vs-product-body">
          <h3 class="vs-product-title">Solar Lights</h3>
          <p class="vs-product-desc">
            All-in-one solar luminaires and street lighting with integrated PV panels, lithium storage, and dusk-to-dawn sensors for autonomous outdoor illumination.
          </p>
          {%- capture default_solar_url -%}{{ base_root | append: '/pages/buy-now?product=solar-lights' }}{%- endcapture -%}
          {%- capture default_solar_collection -%}{{ base_root | append: '/pages/solar-lights' }}{%- endcapture -%}
          <!-- Variant & Pricing Bar -->
          <div class="vs-card-cart-controls">
            <div class="vs-card-variant-row">
              <select class="vs-card-variant-select" data-variant-select aria-label="Select variant for Solar Lights">
                <option value="sl-30w" data-price="3999" selected>30W Standard Luminaire — ₹3,999</option>
                <option value="sl-15w" data-price="2499">15W Compact Luminaire — ₹2,499</option>
                <option value="sl-60w" data-price="6499">60W Heavy-Duty Luminaire — ₹6,499</option>
              </select>
            </div>
            <div class="vs-card-price-row">
              <span class="vs-card-price">₹3,999</span>
              <span class="vs-card-gst-tag">Incl. GST</span>
            </div>
          </div>

          <div class="vs-card-actions">
            <button type="button" class="vs-btn-card-cart" data-add-to-cart data-product-id="solar-street-light" data-product-name="All-in-One Solar Street Light" aria-label="Add Solar Street Light to cart">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              <span>Add to Cart</span>
            </button>
            <a
              href="{{ section.settings.solar_link | default: default_solar_url }}"
              class="vs-product-btn-secondary"
            >
              <span>Buy Now</span>
            </a>
            <a
              href="{{ section.settings.solar_collection | default: default_solar_collection }}"
              class="vs-btn-see-more"
            >
              <span>See More</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>
      </article>

      <!-- Card 2: LED Lamps -->
      <article class="vs-product-card" id="products-led-lamps" data-product-id="led-linear-architectural" data-product-name="Architectural Linear Suspended LED Luminaire">
        <div class="vs-product-image-wrap">
          <span class="vs-product-badge">Commercial & Indoor</span>
          <img
            src="{{ 'led-lamps.jpg' | asset_url }}"
            alt="Vidhyut Saathi modern architectural linear LED lamp"
            class="vs-product-img"
            loading="lazy"
            width="600"
            height="600"
          >
        </div>
        <div class="vs-product-body">
          <h3 class="vs-product-title">LED Lamps</h3>
          <p class="vs-product-desc">
            Modern architectural linear lamps, downlights, and suspended luminaires designed for glare-free, uniform light distribution across workspaces and living areas.
          </p>
          {%- capture default_lamp_url -%}{{ base_root | append: '/pages/buy-now?product=led-lamps' }}{%- endcapture -%}
          {%- capture default_lamp_collection -%}{{ base_root | append: '/pages/led-lamps' }}{%- endcapture -%}
          <!-- Variant & Pricing Bar -->
          <div class="vs-card-cart-controls">
            <div class="vs-card-variant-row">
              <select class="vs-card-variant-select" data-variant-select aria-label="Select variant for LED Lamps">
                <option value="ll-20w" data-price="1299" selected>20W Linear Luminaire — ₹1,299</option>
                <option value="ll-36w" data-price="1899">36W Downlight Panel — ₹1,899</option>
                <option value="ll-48w" data-price="2499">48W Commercial Suspended — ₹2,499</option>
              </select>
            </div>
            <div class="vs-card-price-row">
              <span class="vs-card-price">₹1,299</span>
              <span class="vs-card-gst-tag">Incl. GST</span>
            </div>
          </div>

          <div class="vs-card-actions">
            <button type="button" class="vs-btn-card-cart" data-add-to-cart data-product-id="led-linear-architectural" data-product-name="Architectural Linear Suspended LED Luminaire" aria-label="Add LED Luminaire to cart">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              <span>Add to Cart</span>
            </button>
            <a
              href="{{ section.settings.lamp_link | default: default_lamp_url }}"
              class="vs-product-btn-secondary"
            >
              <span>Buy Now</span>
            </a>
            <a
              href="{{ section.settings.lamp_collection | default: default_lamp_collection }}"
              class="vs-btn-see-more"
            >
              <span>See More</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>
      </article>

      <!-- Card 3: LED Bulbs -->
      <article class="vs-product-card" id="products-led-bulbs" data-product-id="high-efficiency-led-bulb" data-product-name="High-Efficiency LED Household Bulbs (Multipack)">
        <div class="vs-product-image-wrap">
          <span class="vs-product-badge">Energy Saving</span>
          <img
            src="{{ 'led-bulbs.jpg' | asset_url }}"
            alt="Vidhyut Saathi high-efficiency LED bulb with thermal aluminum heat sink"
            class="vs-product-img"
            loading="lazy"
            width="600"
            height="600"
          >
        </div>
        <div class="vs-product-body">
          <h3 class="vs-product-title">LED Bulbs</h3>
          <p class="vs-product-desc">
            High-efficacy, long-life LED bulbs engineered with robust thermal dissipation and high lumen output to ensure durable daily performance.
          </p>
          {%- capture default_bulb_url -%}{{ base_root | append: '/pages/buy-now?product=led-bulbs' }}{%- endcapture -%}
          {%- capture default_bulb_collection -%}{{ base_root | append: '/pages/led-bulbs' }}{%- endcapture -%}
          <!-- Variant & Pricing Bar -->
          <div class="vs-card-cart-controls">
            <div class="vs-card-variant-row">
              <select class="vs-card-variant-select" data-variant-select aria-label="Select variant for LED Bulbs">
                <option value="lb-9w-4p" data-price="449" selected>9W Cool Day (B22 Base, Pack 4) — ₹449</option>
                <option value="lb-12w-4p" data-price="599">12W Bright White (B22, Pack 4) — ₹599</option>
                <option value="lb-18w-2p" data-price="499">18W High-Lumen (Pack 2) — ₹499</option>
              </select>
            </div>
            <div class="vs-card-price-row">
              <span class="vs-card-price">₹449</span>
              <span class="vs-card-gst-tag">Incl. GST</span>
            </div>
          </div>

          <div class="vs-card-actions">
            <button type="button" class="vs-btn-card-cart" data-add-to-cart data-product-id="high-efficiency-led-bulb" data-product-name="High-Efficiency LED Household Bulbs (Multipack)" aria-label="Add LED Bulbs to cart">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              <span>Add to Cart</span>
            </button>
            <a
              href="{{ section.settings.bulb_link | default: default_bulb_url }}"
              class="vs-product-btn-secondary"
            >
              <span>Buy Now</span>
            </a>
            <a
              href="{{ section.settings.bulb_collection | default: default_bulb_collection }}"
              class="vs-btn-see-more"
            >
              <span>See More</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>
      </article>

      <!-- Card 4: Clamp Meters -->
      <article class="vs-product-card" id="products-clamp-meters" data-product-id="meco-27-auto-clamp-meter" data-product-name="MECO 27-AUTO Digital Clamp Meter (400A AC)">
        <div class="vs-product-image-wrap">
          <span class="vs-product-badge">Electrical Testing</span>
          <img
            src="{{ 'clamp-meters.jpg' | asset_url }}"
            alt="Vidhyut Saathi professional digital clamp meter electrical testing tool"
            class="vs-product-img"
            loading="lazy"
            width="600"
            height="600"
          >
        </div>
        <div class="vs-product-body">
          <h3 class="vs-product-title">Clamp Meters</h3>
          <p class="vs-product-desc">
            Rugged digital clamp meters offering accurate AC/DC current, voltage, and continuity testing for professional electricians and maintenance teams.
          </p>
          {%- capture default_clamp_url -%}{{ base_root | append: '/pages/buy-now?product=clamp-meters' }}{%- endcapture -%}
          {%- capture default_clamp_collection -%}{{ base_root | append: '/pages/clamp-meters' }}{%- endcapture -%}
          <!-- Variant & Pricing Bar -->
          <div class="vs-card-cart-controls">
            <div class="vs-card-variant-row">
              <select class="vs-card-variant-select" data-variant-select aria-label="Select variant for Clamp Meters">
                <option value="meco-std" data-price="1599" selected>Standard Kit with Leads — ₹1,599</option>
                <option value="meco-cal" data-price="2099">Calibration Certified Pro Kit — ₹2,099</option>
              </select>
            </div>
            <div class="vs-card-price-row">
              <span class="vs-card-price">₹1,599</span>
              <span class="vs-card-gst-tag">Incl. GST</span>
            </div>
          </div>

          <div class="vs-card-actions">
            <button type="button" class="vs-btn-card-cart" data-add-to-cart data-product-id="meco-27-auto-clamp-meter" data-product-name="MECO 27-AUTO Digital Clamp Meter (400A AC)" aria-label="Add Clamp Meter to cart">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              <span>Add to Cart</span>
            </button>
            <a
              href="{{ section.settings.clamp_link | default: default_clamp_url }}"
              class="vs-product-btn-secondary"
            >
              <span>Buy Now</span>
            </a>
            <a
              href="{{ section.settings.clamp_collection | default: default_clamp_collection }}"
              class="vs-btn-see-more"
            >
              <span>See More</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Section Badge",
      "default": "Our Product Lineup"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Explore Our Products"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Discover reliable solar lighting and electrical solutions from Vidhyut Saathi."
    },
    {
      "type": "url",
      "id": "solar_collection",
      "label": "Solar Lights Collection Link"
    },
    {
      "type": "url",
      "id": "solar_link",
      "label": "Solar Lights Buy Link"
    },
    {
      "type": "url",
      "id": "lamp_collection",
      "label": "LED Lamps Collection Link"
    },
    {
      "type": "url",
      "id": "lamp_link",
      "label": "LED Lamps Buy Link"
    },
    {
      "type": "url",
      "id": "bulb_collection",
      "label": "LED Bulbs Collection Link"
    },
    {
      "type": "url",
      "id": "bulb_link",
      "label": "LED Bulbs Buy Link"
    },
    {
      "type": "url",
      "id": "clamp_collection",
      "label": "Clamp Meters Collection Link"
    },
    {
      "type": "url",
      "id": "clamp_link",
      "label": "Clamp Meters Buy Link"
    }
  ],
  "presets": [
    {
      "name": "Vidhyut Featured Products"
    }
  ]
}
{% endschema %}
