{% comment %}
  Vidhyut Saathi - Section 2: Featured Electrical & Solar Innovations
  Exact 4-Card Grid matching the design system of Section 2.
  Cards:
  1. Digital Clamp Meter
  2. Vidhyut Saathi Saver Card
  3. Multiple Clamp Meters Series
  4. Halonix Solaris LED Light
{% endcomment %}

<section class="vs-products-section vs-featured-showcase-section" id="featured-showcase">
  <div class="vs-container">
    <header class="vs-section-header">
      <div class="vs-section-badge">{{ section.settings.badge | default: 'Featured Innovations' }}</div>
      <h2 class="vs-section-title">{{ section.settings.title | default: 'Best Sellers & Innovations' }}</h2>
      <p class="vs-section-subtitle">
        {{ section.settings.subtitle | default: 'Explore our precision testing instruments, smart electricity saver cards, and commercial solar floodlights.' }}
      </p>
    </header>
    {%- liquid
      assign base_root = routes.root_url
      if base_root == '/'
        assign base_root = ''
      endif
    -%}

    <div class="vs-products-grid">

      <!-- Card 1: Clamp Meter -->
      <article class="vs-product-card" id="showcase-clamp-meter" data-product-id="meco-clamp-meter" data-product-name="Precision Digital Clamp Meter">
        <div class="vs-product-image-wrap">
          <span class="vs-product-badge">{{ section.settings.card1_badge | default: 'Electrical Testing' }}</span>
          {% if section.settings.card1_image != blank %}
            <img
              src="{{ section.settings.card1_image | image_url: width: 600 }}"
              alt="{{ section.settings.card1_title | default: 'Digital Clamp Meter' | escape }}"
              class="vs-product-img"
              loading="lazy"
              width="600"
              height="600"
            >
          {% else %}
            <img
              src="{{ 'clamp-meter-1.jpg' | asset_url }}"
              alt="Vidhyut Saathi Precision Digital Clamp Meter"
              class="vs-product-img"
              loading="lazy"
              width="600"
              height="600"
            >
          {% endif %}
        </div>
        <div class="vs-product-body">
          <h3 class="vs-product-title">{{ section.settings.card1_title | default: 'Digital Clamp Meter' }}</h3>
          <p class="vs-product-desc">
            {{ section.settings.card1_desc | default: 'Rugged digital clamp meters offering accurate AC/DC current, voltage, and continuity testing for professional electricians and maintenance teams.' }}
          </p>
          {%- capture default_clamp_url -%}{{ base_root | append: '/pages/buy-now?product=clamp-meters' }}{%- endcapture -%}
          {%- capture default_clamp_collection -%}{{ base_root | append: '/pages/clamp-meters' }}{%- endcapture -%}
          <!-- Variant & Pricing Bar -->
          <div class="vs-card-cart-controls">
            <div class="vs-card-variant-row">
              <select class="vs-card-variant-select" data-variant-select aria-label="Select variant for Digital Clamp Meter">
                <option value="cm-600a" data-price="1899" selected>600A AC/DC Precision Meter — ₹1,899</option>
                <option value="cm-400a" data-price="1499">400A Compact Digital Tester — ₹1,499</option>
                <option value="cm-1000a" data-price="2799">1000A Heavy Industrial Meter — ₹2,799</option>
              </select>
            </div>
            <div class="vs-card-price-row">
              <span class="vs-card-price">₹1,899</span>
              <span class="vs-card-gst-tag">Incl. GST</span>
            </div>
          </div>

          <div class="vs-card-actions">
            <button type="button" class="vs-btn-card-cart" data-add-to-cart data-product-id="meco-clamp-meter" data-product-name="Digital Clamp Meter" aria-label="Add Digital Clamp Meter to cart">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              <span>Add to Cart</span>
            </button>
            <a
              href="{{ section.settings.card1_link | default: default_clamp_url }}"
              class="vs-product-btn-secondary"
            >
              <span>Buy Now</span>
            </a>
            <a
              href="{{ section.settings.card1_collection | default: default_clamp_collection }}"
              class="vs-btn-see-more"
            >
              <span>See More</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>
      </article>

      <!-- Card 2: Vidhyut Saathi Card -->
      <article class="vs-product-card" id="showcase-vidhyut-card" data-product-id="vidhyut-saver-card" data-product-name="Vidhyut Saathi Power Saver Card">
        <div class="vs-product-image-wrap">
          <span class="vs-product-badge">{{ section.settings.card2_badge | default: 'Smart Energy Saver' }}</span>
          {% if section.settings.card2_image != blank %}
            <img
              src="{{ section.settings.card2_image | image_url: width: 600 }}"
              alt="{{ section.settings.card2_title | default: 'Vidhyut Saathi Power Saver Card' | escape }}"
              class="vs-product-img"
              loading="lazy"
              width="600"
              height="600"
            >
          {% else %}
            <img
              src="{{ 'vidhyut-power-saver-card.jpg' | asset_url }}"
              alt="Vidhyut Saathi Smart Electricity Saver Card"
              class="vs-product-img"
              loading="lazy"
              width="600"
              height="600"
            >
          {% endif %}
        </div>
        <div class="vs-product-body">
          <h3 class="vs-product-title">{{ section.settings.card2_title | default: 'Vidhyut Saathi Saver Card' }}</h3>
          <p class="vs-product-desc">
            {{ section.settings.card2_desc | default: "India's No.1 smart electricity saver card engineered with US-German nanotechnology to optimize household and commercial power bills." }}
          </p>
          {%- capture default_card_url -%}{{ base_root | append: '/pages/buy-now?product=saver-card' }}{%- endcapture -%}
          {%- capture default_card_collection -%}{{ base_root | append: '/pages/products' }}{%- endcapture -%}
          <!-- Variant & Pricing Bar -->
          <div class="vs-card-cart-controls">
            <div class="vs-card-variant-row">
              <select class="vs-card-variant-select" data-variant-select aria-label="Select variant for Vidhyut Saathi Card">
                <option value="vsc-10kw" data-price="2499" selected>Smart Saver Card (Up to 10KW) — ₹2,499</option>
                <option value="vsc-20kw" data-price="4499">Commercial Pack (Up to 20KW) — ₹4,499</option>
                <option value="vsc-30kw" data-price="5999">Heavy Duty Industrial Pack — ₹5,999</option>
              </select>
            </div>
            <div class="vs-card-price-row">
              <span class="vs-card-price">₹2,499</span>
              <span class="vs-card-gst-tag">Incl. GST</span>
            </div>
          </div>

          <div class="vs-card-actions">
            <button type="button" class="vs-btn-card-cart" data-add-to-cart data-product-id="vidhyut-saver-card" data-product-name="Vidhyut Saathi Power Saver Card" aria-label="Add Vidhyut Saathi Saver Card to cart">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              <span>Add to Cart</span>
            </button>
            <a
              href="{{ section.settings.card2_link | default: default_card_url }}"
              class="vs-product-btn-secondary"
            >
              <span>Buy Now</span>
            </a>
            <a
              href="{{ section.settings.card2_collection | default: default_card_collection }}"
              class="vs-btn-see-more"
            >
              <span>See More</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>
      </article>

      <!-- Card 3: Multiple Clamp Meters -->
      <article class="vs-product-card" id="showcase-multiple-clamps" data-product-id="industrial-clamp-series" data-product-name="Multiple Clamp Meters Series">
        <div class="vs-product-image-wrap">
          <span class="vs-product-badge">{{ section.settings.card3_badge | default: 'Industrial Series' }}</span>
          {% if section.settings.card3_image != blank %}
            <img
              src="{{ section.settings.card3_image | image_url: width: 600 }}"
              alt="{{ section.settings.card3_title | default: 'Multiple Clamp Meters' | escape }}"
              class="vs-product-img"
              loading="lazy"
              width="600"
              height="600"
            >
          {% else %}
            <img
              src="{{ 'clamp-meters.jpg' | asset_url }}"
              alt="Vidhyut Saathi Multiple Clamp Meters Range"
              class="vs-product-img"
              loading="lazy"
              width="600"
              height="600"
            >
          {% endif %}
        </div>
        <div class="vs-product-body">
          <h3 class="vs-product-title">{{ section.settings.card3_title | default: 'Multiple Clamp Meters' }}</h3>
          <p class="vs-product-desc">
            {{ section.settings.card3_desc | default: 'Comprehensive lineup of multi-range digital clamp meters, test probes, and heavy-duty electrical testing instruments.' }}
          </p>
          {%- capture default_multi_clamp_url -%}{{ base_root | append: '/pages/buy-now?product=clamp-meters' }}{%- endcapture -%}
          {%- capture default_multi_clamp_collection -%}{{ base_root | append: '/pages/clamp-meters' }}{%- endcapture -%}
          <!-- Variant & Pricing Bar -->
          <div class="vs-card-cart-controls">
            <div class="vs-card-variant-row">
              <select class="vs-card-variant-select" data-variant-select aria-label="Select variant for Multiple Clamp Meters">
                <option value="cm-combo-pro" data-price="3299" selected>Industrial Multi-Meter Combo — ₹3,299</option>
                <option value="cm-kit-electrician" data-price="4999">Electrician Complete Toolkit — ₹4,999</option>
                <option value="cm-dual-range" data-price="2599">Dual-Range Testing Bundle — ₹2,599</option>
              </select>
            </div>
            <div class="vs-card-price-row">
              <span class="vs-card-price">₹3,299</span>
              <span class="vs-card-gst-tag">Incl. GST</span>
            </div>
          </div>

          <div class="vs-card-actions">
            <button type="button" class="vs-btn-card-cart" data-add-to-cart data-product-id="industrial-clamp-series" data-product-name="Multiple Clamp Meters Series" aria-label="Add Clamp Meter Series to cart">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              <span>Add to Cart</span>
            </button>
            <a
              href="{{ section.settings.card3_link | default: default_multi_clamp_url }}"
              class="vs-product-btn-secondary"
            >
              <span>Buy Now</span>
            </a>
            <a
              href="{{ section.settings.card3_collection | default: default_multi_clamp_collection }}"
              class="vs-btn-see-more"
            >
              <span>See More</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>
      </article>

      <!-- Card 4: Halonix Light -->
      <article class="vs-product-card" id="showcase-halonix-light" data-product-id="halonix-solaris-light" data-product-name="Halonix Solaris LED Light">
        <div class="vs-product-image-wrap">
          <span class="vs-product-badge">{{ section.settings.card4_badge | default: 'High-Lumen Solar' }}</span>
          {% if section.settings.card4_image != blank %}
            <img
              src="{{ section.settings.card4_image | image_url: width: 600 }}"
              alt="{{ section.settings.card4_title | default: 'Halonix Solaris LED Light' | escape }}"
              class="vs-product-img"
              loading="lazy"
              width="600"
              height="600"
            >
          {% else %}
            <img
              src="{{ 'solar-lights-1.jpg' | asset_url }}"
              alt="Halonix Solaris High-Lumen Solar LED Floodlight"
              class="vs-product-img"
              loading="lazy"
              width="600"
              height="600"
            >
          {% endif %}
        </div>
        <div class="vs-product-body">
          <h3 class="vs-product-title">{{ section.settings.card4_title | default: 'Halonix Solaris LED Light' }}</h3>
          <p class="vs-product-desc">
            {{ section.settings.card4_desc | default: 'High-lumen solar floodlights and outdoor luminaires engineered for industrial durability, zero electricity bills, and weather-resistant coverage.' }}
          </p>
          {%- capture default_halonix_url -%}{{ base_root | append: '/pages/buy-now?product=solar-lights' }}{%- endcapture -%}
          {%- capture default_halonix_collection -%}{{ base_root | append: '/pages/solar-lights' }}{%- endcapture -%}
          <!-- Variant & Pricing Bar -->
          <div class="vs-card-cart-controls">
            <div class="vs-card-variant-row">
              <select class="vs-card-variant-select" data-variant-select aria-label="Select variant for Halonix Light">
                <option value="hx-50w" data-price="4499" selected>Halonix Solaris 50W Floodlight — ₹4,499</option>
                <option value="hx-30w" data-price="2999">Halonix Solaris 30W Outdoor — ₹2,999</option>
                <option value="hx-100w" data-price="7999">Halonix Heavy 100W Commercial — ₹7,999</option>
              </select>
            </div>
            <div class="vs-card-price-row">
              <span class="vs-card-price">₹4,499</span>
              <span class="vs-card-gst-tag">Incl. GST</span>
            </div>
          </div>

          <div class="vs-card-actions">
            <button type="button" class="vs-btn-card-cart" data-add-to-cart data-product-id="halonix-solaris-light" data-product-name="Halonix Solaris LED Light" aria-label="Add Halonix Light to cart">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              <span>Add to Cart</span>
            </button>
            <a
              href="{{ section.settings.card4_link | default: default_halonix_url }}"
              class="vs-product-btn-secondary"
            >
              <span>Buy Now</span>
            </a>
            <a
              href="{{ section.settings.card4_collection | default: default_halonix_collection }}"
              class="vs-btn-see-more"
            >
              <span>See More</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>
      </article>

    </div>
  </div>
</section>

