{% comment %}
  Vidhyut Saathi - Section 2: Featured Electrical & Solar Innovations
  4-Card Grid matching the design system of Section 2.
  Cards:
  1. Digital Clamp Meter
  2. Vidhyut Saathi Saver Card
  3. Multiple Clamp Meters Series (with Image Slider)
  4. Halonix Solaris LED Light
{% endcomment %}

<section class="vs-products-section vs-featured-showcase-section" id="featured-showcase">
  <div class="vs-container">
    <header class="vs-section-header">
      <div class="vs-section-badge">{{ section.settings.badge | default: 'Featured Innovations' }}</div>
      <h2 class="vs-section-title">{{ section.settings.title | default: 'Best Sellers & Innovations' }}</h2>
      <p class="vs-section-subtitle">
        {{ section.settings.subtitle | default: 'Explore our precision testing instruments, smart electricity saver cards, and commercial solar floodlights.' }}
      </p>
    </header>
    {%- liquid
      assign base_root = routes.root_url
      if base_root == '/'
        assign base_root = ''
      endif
    -%}

    <div class="vs-products-grid">

      <!-- Card 1: Clamp Meter -->
      {%- liquid
        if section.settings.card1_image != blank
          assign card1_img_src = section.settings.card1_image | image_url: width: 600
        else
          assign card1_img_src = 'clamp-meter-1.jpg' | asset_url
        endif
        assign card1_price_val = section.settings.card1_price | default: '₹1,899'
        assign card1_price_num = card1_price_val | remove: '₹' | remove: ',' | strip
      -%}
      <article class="vs-product-card" id="showcase-clamp-meter" data-product-id="meco-clamp-meter" data-product-name="{{ section.settings.card1_title | default: 'Digital Clamp Meter' | escape }}">
        <div class="vs-product-image-wrap">
          <img
            src="{{ card1_img_src }}"
            alt="{{ section.settings.card1_title | default: 'Digital Clamp Meter' | escape }}"
            class="vs-product-img"
            loading="lazy"
            width="600"
            height="600"
          >
        </div>
        <div class="vs-product-body">
          <h3 class="vs-product-title">{{ section.settings.card1_title | default: 'MECO 27 AUTO BL CLAMP METER' }}</h3>
          <p class="vs-product-desc">
            {{ section.settings.card1_desc | default: 'Rugged digital clamp meters offering accurate AC/DC current, voltage, and continuity testing for professional electricians and maintenance teams.' }}
          </p>
          {%- capture default_clamp_url -%}{{ base_root | append: '/pages/buy-now?product=clamp-meters' }}{%- endcapture -%}
          {%- capture default_clamp_collection -%}{{ base_root | append: '/pages/clamp-meters' }}{%- endcapture -%}
          <!-- Pricing Bar -->
          <div class="vs-card-cart-controls">
            <div class="vs-card-price-row">
              <span class="vs-card-price">{{ card1_price_val }}</span>
              <span class="vs-card-gst-tag">Incl. GST</span>
            </div>
          </div>

          <div class="vs-card-actions">
            <button
              type="button"
              class="vs-btn-card-cart"
              data-add-to-cart
              data-product-id="meco-clamp-meter"
              data-variant-id="meco-clamp-meter"
              data-product-name="{{ section.settings.card1_title | default: 'Digital Clamp Meter' | escape }}"
              data-image="{{ card1_img_src }}"
              data-price="{{ card1_price_num }}"
              aria-label="Add Digital Clamp Meter to cart"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              <span>Add to Cart</span>
            </button>
            <a
              href="{{ section.settings.card1_link | default: default_clamp_url }}"
              class="vs-product-btn-secondary"
            >
              <span>Buy Now</span>
            </a>
          </div>
        </div>
      </article>

      <!-- Card 2: Vidhyut Saathi Card -->
      {%- liquid
        if section.settings.card2_image != blank
          assign card2_img_src = section.settings.card2_image | image_url: width: 600
        else
          assign card2_img_src = 'vidhyut-power-saver-card.jpg' | asset_url
        endif
        assign card2_price_val = section.settings.card2_price | default: '₹2,499'
        assign card2_price_num = card2_price_val | remove: '₹' | remove: ',' | strip
      -%}
      <article class="vs-product-card" id="showcase-vidhyut-card" data-product-id="vidhyut-saver-card" data-product-name="{{ section.settings.card2_title | default: 'Vidhyut Saathi Saver Card' | escape }}">
        <div class="vs-product-image-wrap">
          <img
            src="{{ card2_img_src }}"
            alt="{{ section.settings.card2_title | default: 'Vidhyut Saathi Power Saver Card' | escape }}"
            class="vs-product-img"
            loading="lazy"
            width="600"
            height="600"
          >
        </div>
        <div class="vs-product-body">
          <h3 class="vs-product-title">{{ section.settings.card2_title | default: 'Vidhyut Saathi Saver Card' }}</h3>
          <p class="vs-product-desc">
            {{ section.settings.card2_desc | default: "India's No.1 smart electricity saver card engineered with US-German nanotechnology to optimize household and commercial power bills." }}
          </p>
          {%- capture default_card_url -%}{{ base_root | append: '/pages/buy-now?product=saver-card' }}{%- endcapture -%}
          {%- capture default_card_collection -%}{{ base_root | append: '/pages/products' }}{%- endcapture -%}
          <!-- Pricing Bar -->
          <div class="vs-card-cart-controls">
            <div class="vs-card-price-row">
              <span class="vs-card-price">{{ card2_price_val }}</span>
              <span class="vs-card-gst-tag">Incl. GST</span>
            </div>
          </div>

          <div class="vs-card-actions">
            <button
              type="button"
              class="vs-btn-card-cart"
              data-add-to-cart
              data-product-id="vidhyut-saver-card"
              data-variant-id="vidhyut-saver-card"
              data-product-name="{{ section.settings.card2_title | default: 'Vidhyut Saathi Saver Card' | escape }}"
              data-image="{{ card2_img_src }}"
              data-price="{{ card2_price_num }}"
              aria-label="Add Vidhyut Saathi Saver Card to cart"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              <span>Add to Cart</span>
            </button>
            <a
              href="{{ section.settings.card2_link | default: default_card_url }}"
              class="vs-product-btn-secondary"
            >
              <span>Buy Now</span>
            </a>
          </div>
        </div>
      </article>

      <!-- Card 3: Multiple Clamp Meters -->
      {%- liquid
        if section.settings.card3_image != blank
          assign card3_img_src = section.settings.card3_image | image_url: width: 600
        else
          assign card3_img_src = 'clamp-meters.jpg' | asset_url
        endif
        assign card3_price_val = section.settings.card3_price | default: '₹3,299'
        assign card3_price_num = card3_price_val | remove: '₹' | remove: ',' | strip
      -%}
      <article class="vs-product-card" id="showcase-multiple-clamps" data-product-id="industrial-clamp-series" data-product-name="{{ section.settings.card3_title | default: 'Multiple Clamp Meters' | escape }}">
        <div class="vs-product-image-wrap">
          <img
            src="{{ card3_img_src }}"
            alt="{{ section.settings.card3_title | default: 'Multiple Clamp Meters' | escape }}"
            class="vs-product-img"
            loading="lazy"
            width="600"
            height="600"
          >
        </div>

        <div class="vs-product-body">
          <h3 class="vs-product-title">{{ section.settings.card3_title | default: 'Multiple Clamp Meters' }}</h3>
          <p class="vs-product-desc">
            {{ section.settings.card3_desc | default: 'Comprehensive lineup of multi-range digital clamp meters, test probes, and heavy-duty electrical testing instruments.' }}
          </p>
          {%- capture default_multi_clamp_url -%}{{ base_root | append: '/pages/buy-now?product=clamp-meters' }}{%- endcapture -%}
          {%- capture default_multi_clamp_collection -%}{{ base_root | append: '/pages/clamp-meters' }}{%- endcapture -%}
          <!-- Pricing Bar -->
          <div class="vs-card-cart-controls">
            <div class="vs-card-price-row">
              <span class="vs-card-price">{{ card3_price_val }}</span>
              <span class="vs-card-gst-tag">Incl. GST</span>
            </div>
          </div>

          <div class="vs-card-actions">
            <button
              type="button"
              class="vs-btn-card-cart"
              data-add-to-cart
              data-product-id="industrial-clamp-series"
              data-variant-id="industrial-clamp-series"
              data-product-name="{{ section.settings.card3_title | default: 'Multiple Clamp Meters Series' | escape }}"
              data-image="{{ card3_img_src }}"
              data-price="{{ card3_price_num }}"
              aria-label="Add Clamp Meter Series to cart"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              <span>Add to Cart</span>
            </button>
            <a
              href="{{ section.settings.card3_link | default: default_multi_clamp_url }}"
              class="vs-product-btn-secondary"
            >
              <span>Buy Now</span>
            </a>
          </div>
        </div>
      </article>

      <!-- Card 4: New Product -->
      {%- liquid
        if section.settings.card4_image != blank
          assign card4_img_src = section.settings.card4_image | image_url: width: 600
        else
          assign card4_img_src = 'solar-lights.jpg' | asset_url
        endif
        assign card4_price_val = section.settings.card4_price | default: '₹0'
        assign card4_price_num = card4_price_val | remove: '₹' | remove: ',' | strip
      -%}
      <article class="vs-product-card" id="showcase-new-product" data-product-id="new-product" data-product-name="{{ section.settings.card4_title | default: 'New Product' | escape }}">
        <div class="vs-product-image-wrap">
          {% if section.settings.card4_badge != blank %}
            <span class="vs-product-badge">{{ section.settings.card4_badge | escape }}</span>
          {% endif %}
          <img
            src="{{ card4_img_src }}"
            alt="{{ section.settings.card4_title | default: 'New Product' | escape }}"
            class="vs-product-img"
            loading="lazy"
            width="600"
            height="600"
            onerror="window.vidhyutAssetFallback && window.vidhyutAssetFallback(this, 'solar-lights.jpg');"
          >
        </div>
        <div class="vs-product-body">
          <h3 class="vs-product-title">{{ section.settings.card4_title | default: 'New Product' }}</h3>
          <p class="vs-product-desc">
            {{ section.settings.card4_desc | default: 'Configure your new product title, description, image and pricing directly in the Shopify theme editor.' }}
          </p>
          {%- capture default_new_url -%}{{ base_root | append: '/pages/buy-now' }}{%- endcapture -%}
          <!-- Pricing Bar -->
          <div class="vs-card-cart-controls">
            <div class="vs-card-price-row">
              <span class="vs-card-price">{{ card4_price_val }}</span>
              <span class="vs-card-gst-tag">Incl. GST</span>
            </div>
          </div>

          <div class="vs-card-actions">
            <button
              type="button"
              class="vs-btn-card-cart"
              data-add-to-cart
              data-product-id="new-product"
              data-variant-id="new-product"
              data-product-name="{{ section.settings.card4_title | default: 'New Product' | escape }}"
              data-image="{{ card4_img_src }}"
              data-price="{{ card4_price_num }}"
              aria-label="Add New Product to cart"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              <span>Add to Cart</span>
            </button>
            <a
              href="{{ section.settings.card4_link | default: default_new_url }}"
              class="vs-product-btn-secondary"
            >
              <span>Buy Now</span>
            </a>
          </div>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  .vs-card-slider {
    position: relative;
    overflow: hidden;
  }

  .vs-card-slider-track {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .vs-card-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vs-card-slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .vs-card-slide .vs-product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vs-card-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(0, 0, 0, 0.08);
    color: #1e293b;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    z-index: 5;
    opacity: 0;
    transition: opacity 0.2s ease, background-color 0.2s ease, transform 0.2s ease, color 0.2s ease;
  }

  .vs-product-card:hover .vs-card-nav-btn,
  .vs-card-slider:hover .vs-card-nav-btn {
    opacity: 1;
  }

  .vs-card-nav-prev {
    left: 8px;
  }

  .vs-card-nav-next {
    right: 8px;
  }

  .vs-card-nav-btn:hover {
    background: #ffffff;
    transform: translateY(-50%) scale(1.08);
    color: #ea580c;
  }

  .vs-card-slider-dots {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 5;
    padding: 3px 8px;
    background: rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(4px);
    border-radius: 9999px;
  }

  .vs-card-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.6);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .vs-card-dot.is-active {
    width: 18px;
    border-radius: 9999px;
    background: #ffffff;
  }

  @media (max-width: 768px) {
    .vs-card-nav-btn {
      opacity: 0.9;
      width: 28px;
      height: 28px;
    }
  }
</style>

<script>
  (function() {
    function initCardSliders() {
      var sliders = document.querySelectorAll('[data-card-slider]');
      sliders.forEach(function(slider) {
        if (slider.dataset.initialized) return;
        slider.dataset.initialized = 'true';

        var slides = slider.querySelectorAll('.vs-card-slide');
        var dots = slider.querySelectorAll('.vs-card-dot');
        var prevBtn = slider.querySelector('[data-slider-prev]');
        var nextBtn = slider.querySelector('[data-slider-next]');
        var currentIndex = 0;
        var autoTimer = null;

        function goToSlide(index) {
          if (index < 0) index = slides.length - 1;
          if (index >= slides.length) index = 0;
          currentIndex = index;

          slides.forEach(function(slide, idx) {
            if (idx === currentIndex) {
              slide.classList.add('is-active');
            } else {
              slide.classList.remove('is-active');
            }
          });

          dots.forEach(function(dot, idx) {
            if (idx === currentIndex) {
              dot.classList.add('is-active');
            } else {
              dot.classList.remove('is-active');
            }
          });
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            goToSlide(currentIndex - 1);
            resetAuto();
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            goToSlide(currentIndex + 1);
            resetAuto();
          });
        }

        dots.forEach(function(dot, idx) {
          dot.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            goToSlide(idx);
            resetAuto();
          });
        });

        var touchStartX = 0;
        slider.addEventListener('touchstart', function(e) {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        slider.addEventListener('touchend', function(e) {
          var touchEndX = e.changedTouches[0].screenX;
          var diff = touchStartX - touchEndX;
          if (Math.abs(diff) > 35) {
            if (diff > 0) goToSlide(currentIndex + 1);
            else goToSlide(currentIndex - 1);
            resetAuto();
          }
        }, { passive: true });

        function startAuto() {
          autoTimer = setInterval(function() {
            goToSlide(currentIndex + 1);
          }, 3800);
        }
        function stopAuto() {
          if (autoTimer) clearInterval(autoTimer);
        }
        function resetAuto() {
          stopAuto();
          startAuto();
        }

        slider.addEventListener('mouseenter', stopAuto);
        slider.addEventListener('mouseleave', startAuto);
        startAuto();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCardSliders);
    } else {
      initCardSliders();
    }
  })();
</script>

