<header class="vs-header" id="mainHeader">
  <div class="vs-container">
    <div class="vs-header-inner">
      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="vs-logo-link" aria-label="Vidhyut Saathi Home">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 120 }}"
            alt="{{ shop.name | escape }}"
            class="vs-logo-img"
            width="48"
            height="48"
          >
        {% else %}
          <img
            src="{{ 'vidhyut-logo-official.png' | asset_url }}"
            alt="Vidhyut Saathi Logo"
            class="vs-logo-img"
            width="48"
            height="48"
          >
        {% endif %}
        <div class="vs-logo-text-wrap">
          <span class="vs-logo-brand">{{ section.settings.brand_name | default: 'Vidhyut Saathi' }}</span>
          <span class="vs-logo-tagline">{{ section.settings.tagline | default: 'Solar & Electrical' }}</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="vs-nav-desktop" aria-label="Main Navigation">
        <ul class="vs-nav-list">
          {%- liquid
            assign base_root = routes.root_url
            if base_root == '/'
              assign base_root = ''
            endif

            if section.settings.about_link != blank
              assign about_page_url = section.settings.about_link
            elsif pages['about-us'].url != blank
              assign about_page_url = pages['about-us'].url
            elsif pages['about'].url != blank
              assign about_page_url = pages['about'].url
            else
              assign about_page_url = base_root | append: '/pages/about-us'
            endif

            if section.settings.products_link != blank
              assign products_page_url = section.settings.products_link
            elsif pages['products'].url != blank
              assign products_page_url = pages['products'].url
            elsif pages['our-products'].url != blank
              assign products_page_url = pages['our-products'].url
            elsif pages['all-products'].url != blank
              assign products_page_url = pages['all-products'].url
            elsif pages['product'].url != blank
              assign products_page_url = pages['product'].url
            elsif routes.all_products_collection_url != blank
              assign products_page_url = routes.all_products_collection_url
            else
              assign products_page_url = base_root | append: '/pages/products'
            endif

            if section.settings.contact_link != blank
              assign contact_page_url = section.settings.contact_link
            elsif pages['contact-us'].url != blank
              assign contact_page_url = pages['contact-us'].url
            elsif pages['contact'].url != blank
              assign contact_page_url = pages['contact'].url
            else
              assign contact_page_url = base_root | append: '/pages/contact-us'
            endif

            if section.settings.distributor_link != blank
              assign distributor_page_url = section.settings.distributor_link
            elsif pages['buy-distributorship'].url != blank
              assign distributor_page_url = pages['buy-distributorship'].url
            elsif pages['distributorship'].url != blank
              assign distributor_page_url = pages['distributorship'].url
            elsif pages['get-franchise'].url != blank
              assign distributor_page_url = pages['get-franchise'].url
            else
              assign distributor_page_url = base_root | append: '/pages/buy-distributorship'
            endif

            if section.settings.buy_now_link != blank
              assign buy_now_page_url = section.settings.buy_now_link
            elsif pages['buy-now'].url != blank
              assign buy_now_page_url = pages['buy-now'].url
            elsif pages['buynow'].url != blank
              assign buy_now_page_url = pages['buynow'].url
            else
              assign buy_now_page_url = base_root | append: '/pages/buy-now'
            endif

            assign menu_has_about = false
            if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0
              for l in linklists[section.settings.menu].links
                assign l_clean = l.title | downcase | strip
                if l_clean contains 'about'
                  assign menu_has_about = true
                endif
              endfor
            endif
          -%}

          {%- if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 -%}
            {%- for link in linklists[section.settings.menu].links -%}
              {%- assign link_title_clean = link.title | strip -%}
              {%- assign link_title_downcase = link_title_clean | downcase -%}

              {%- if link_title_downcase == 'home' -%}
                <li>
                  <a
                    href="{{ link.url }}"
                    class="vs-nav-link {% if link.active or template.name == 'index' %}is-active{% endif %}"
                  >
                    Home
                  </a>
                </li>
                {%- unless menu_has_about -%}
                  <li>
                    <a
                      href="{{ about_page_url }}"
                      class="vs-nav-link {% if page.handle == 'about-us' or template.suffix == 'about-us' %}is-active{% endif %}"
                    >
                      About Us
                    </a>
                  </li>
                {%- endunless -%}

              {%- elsif link_title_downcase == 'about' or link_title_downcase == 'about us' -%}
                <li>
                  <a
                    href="{{ link.url | default: about_page_url }}"
                    class="vs-nav-link {% if link.active or page.handle == 'about-us' or template.suffix == 'about-us' %}is-active{% endif %}"
                  >
                    About Us
                  </a>
                </li>

              {%- elsif link_title_downcase == 'catalog' or link_title_downcase == 'catalogue' or link_title_downcase == 'products' or link.url == '/collections/all' or link.url contains '#products' -%}
                {%- liquid
                  if link.url contains '#products' or link.url == '/' or link.url == routes.root_url or link.url == '/collections/all'
                    assign nav_product_href = products_page_url
                  else
                    assign nav_product_href = link.url | default: products_page_url
                  endif
                -%}
                <li>
                  <a
                    href="{{ nav_product_href }}"
                    class="vs-nav-link {% if link.active or page.handle == 'products' or page.handle == 'our-products' or page.handle == 'all-products' or template.suffix == 'products' or template.name == 'collection' %}is-active{% endif %}"
                  >
                    Products
                  </a>
                </li>

              {%- elsif link_title_downcase == 'contact us' or link_title_downcase == 'contact' -%}
                <li>
                  <a
                    href="{{ link.url | default: contact_page_url }}"
                    class="vs-nav-link {% if link.active or page.handle == 'contact' or page.handle == 'contact-us' or template.suffix == 'contact' or template.suffix == 'contact-us' or template.name == 'page' and page.handle contains 'contact' %}is-active{% endif %}"
                  >
                    Contact
                  </a>
                </li>

              {%- else -%}
                <li>
                  <a
                    href="{{ link.url }}"
                    class="vs-nav-link {% if link.active or link.child_active %}is-active{% endif %}"
                  >
                    {{ link.title }}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.root_url }}" class="vs-nav-link {% if template.name == 'index' %}is-active{% endif %}">Home</a></li>
            <li><a href="{{ about_page_url }}" class="vs-nav-link {% if page.handle == 'about-us' or template.suffix == 'about-us' %}is-active{% endif %}">About Us</a></li>
            <li><a href="{{ products_page_url }}" class="vs-nav-link {% if page.handle == 'products' or page.handle == 'our-products' or page.handle == 'all-products' or template.suffix == 'products' or template.name == 'collection' %}is-active{% endif %}">Products</a></li>
            <li><a href="{{ contact_page_url }}" class="vs-nav-link {% if page.handle == 'contact' or page.handle == 'contact-us' or template.suffix == 'contact' or template.suffix == 'contact-us' or template.name == 'page' and page.handle contains 'contact' %}is-active{% endif %}">Contact</a></li>
          {%- endif -%}
        </ul>
      </nav>

      <!-- Desktop CTA Action Buttons -->
      <div class="vs-header-actions">
        <a
          href="{{ buy_now_page_url }}"
          class="vs-btn vs-btn-accent vs-btn-buynow {% if page.handle == 'buy-now' or template.suffix == 'buy-now' %}is-active{% endif %}"
          id="headerBuyNowBtn"
          aria-label="Shopping Cart & Buy Now"
        >
          <svg class="vs-cart-btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          <span>{{ section.settings.buy_now_label | default: 'Buy Now' }}</span>
          <span class="vs-navbar-cart-count" id="navbarCartBadge">0</span>
        </a>
        <a
          href="{{ distributor_page_url }}"
          class="vs-btn vs-btn-outline {% if page.handle == 'buy-distributorship' or page.handle == 'distributorship' or page.handle == 'get-franchise' or template.suffix == 'buy-distributorship' or template.suffix == 'distributorship' or template.suffix == 'get-franchise' %}is-active{% endif %}"
          id="headerDistributorBtn"
        >
          {{ section.settings.distributor_label | default: 'Buy Distributorship' }}
        </a>
      </div>

      <!-- Mobile Hamburger Toggle -->
      <button
        type="button"
        class="vs-nav-toggle"
        id="vsNavToggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="vsMobileDrawer"
      >
        <span class="vs-hamburger-bar"></span>
        <span class="vs-hamburger-bar"></span>
        <span class="vs-hamburger-bar"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Drawer Backdrop -->
<div class="vs-nav-backdrop" id="vsNavBackdrop" style="display: none; visibility: hidden;"></div>

<!-- Mobile Navigation Drawer -->
<div class="vs-mobile-drawer" id="vsMobileDrawer" role="dialog" aria-modal="true" aria-label="Navigation Menu" style="display: none; visibility: hidden;">
  <div class="vs-mobile-drawer-header">
    <div class="vs-logo-link">
      <img
        src="{{ 'vidhyut-logo-official.png' | asset_url }}"
        alt="Vidhyut Saathi Logo"
        class="vs-logo-img"
        width="40"
        height="40"
      >
      <span class="vs-logo-brand">Vidhyut Saathi</span>
    </div>
    <button
      type="button"
      class="vs-mobile-close-btn"
      id="vsMobileCloseBtn"
      aria-label="Close menu"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <ul class="vs-mobile-nav-list">
    {%- if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 -%}
      {%- for link in linklists[section.settings.menu].links -%}
        {%- assign link_title_clean = link.title | strip -%}
        {%- assign link_title_downcase = link_title_clean | downcase -%}

        {%- if link_title_downcase == 'home' -%}
          <li>
            <a
              href="{{ link.url }}"
              class="vs-mobile-nav-link {% if link.active or template.name == 'index' %}is-active{% endif %}"
            >
              <span>Home</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </li>
          {%- unless menu_has_about -%}
            <li>
              <a
                href="{{ about_page_url }}"
                class="vs-mobile-nav-link {% if page.handle == 'about-us' or template.suffix == 'about-us' %}is-active{% endif %}"
              >
                <span>About Us</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
            </li>
          {%- endunless -%}

        {%- elsif link_title_downcase == 'about' or link_title_downcase == 'about us' -%}
          <li>
            <a
              href="{{ link.url | default: about_page_url }}"
              class="vs-mobile-nav-link {% if link.active or page.handle == 'about-us' or template.suffix == 'about-us' %}is-active{% endif %}"
            >
              <span>About Us</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </li>

        {%- elsif link_title_downcase == 'catalog' or link_title_downcase == 'catalogue' or link_title_downcase == 'products' or link.url == '/collections/all' or link.url contains '#products' -%}
          {%- liquid
            if link.url contains '#products' or link.url == '/' or link.url == routes.root_url or link.url == '/collections/all'
              assign mob_product_href = products_page_url
            else
              assign mob_product_href = link.url | default: products_page_url
            endif
          -%}
          <li>
            <a
              href="{{ mob_product_href }}"
              class="vs-mobile-nav-link {% if link.active or page.handle == 'products' or page.handle == 'our-products' or page.handle == 'all-products' or template.suffix == 'products' or template.name == 'collection' %}is-active{% endif %}"
            >
              <span>Products</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </li>

        {%- elsif link_title_downcase == 'contact us' or link_title_downcase == 'contact' -%}
          <li>
            <a
              href="{{ link.url | default: contact_page_url }}"
              class="vs-mobile-nav-link {% if link.active or page.handle == 'contact' or page.handle == 'contact-us' or template.suffix == 'contact' or template.suffix == 'contact-us' or template.name == 'page' and page.handle contains 'contact' %}is-active{% endif %}"
            >
              <span>Contact</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </li>

        {%- else -%}
          <li>
            <a
              href="{{ link.url }}"
              class="vs-mobile-nav-link {% if link.active or link.child_active %}is-active{% endif %}"
            >
              <span>{{ link.title }}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <li>
        <a href="{{ routes.root_url }}" class="vs-mobile-nav-link {% if template.name == 'index' %}is-active{% endif %}">
          <span>Home</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </li>
      <li>
        <a href="{{ about_page_url }}" class="vs-mobile-nav-link {% if page.handle == 'about-us' or template.suffix == 'about-us' %}is-active{% endif %}">
          <span>About Us</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </li>
      <li>
        <a href="{{ products_page_url }}" class="vs-mobile-nav-link {% if page.handle == 'products' or page.handle == 'our-products' or page.handle == 'all-products' or template.suffix == 'products' or template.name == 'collection' %}is-active{% endif %}">
          <span>Products</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </li>
      <li>
        <a href="{{ contact_page_url }}" class="vs-mobile-nav-link {% if page.handle == 'contact' or page.handle == 'contact-us' or template.suffix == 'contact' or template.suffix == 'contact-us' or template.name == 'page' and page.handle contains 'contact' %}is-active{% endif %}">
          <span>Contact</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </li>
    {%- endif -%}
  </ul>

  <div class="vs-mobile-actions">
    <a
      href="{{ buy_now_page_url }}"
      class="vs-btn vs-btn-accent vs-btn-buynow {% if page.handle == 'buy-now' or template.suffix == 'buy-now' %}is-active{% endif %}"
      id="mobileBuyNowBtn"
      aria-label="Shopping Cart & Buy Now"
    >
      <svg class="vs-cart-btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
      <span>{{ section.settings.buy_now_label | default: 'Buy Now' }}</span>
      <span class="vs-navbar-cart-count" id="mobileNavbarCartBadge">0</span>
    </a>
    <a
      href="{{ distributor_page_url }}"
      class="vs-btn vs-btn-outline {% if page.handle == 'buy-distributorship' or page.handle == 'distributorship' or page.handle == 'get-franchise' or template.suffix == 'buy-distributorship' or template.suffix == 'distributorship' or template.suffix == 'get-franchise' %}is-active{% endif %}"
      id="mobileDistributorBtn"
    >
      {{ section.settings.distributor_label | default: 'Buy Distributorship' }}
    </a>
    <div class="vs-mobile-contact-snippet">
      Direct Inquiries: <a href="tel:+918199036060">+91-8199036060</a>
    </div>
  </div>
</div>

<!-- Global Shopping Cart Slide-Over Drawer -->
<div class="vs-cart-drawer-backdrop" id="cartDrawerBackdrop" style="display: none; visibility: hidden;"></div>
<aside class="vs-cart-drawer" id="cartDrawer" aria-label="Shopping Cart Drawer" style="display: none; visibility: hidden;">
  <div class="vs-cart-header">
    <div class="vs-cart-title-wrap">
      <h3 class="vs-cart-title">Your Cart</h3>
      <span class="vs-cart-badge-count" id="cartBadgeCount">0</span>
    </div>
    <button type="button" class="vs-cart-close" id="cartDrawerClose" aria-label="Close cart drawer">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>

  <div class="vs-cart-items-wrap" id="cartItemsWrap">
    <!-- Populated dynamically via vidhyut-cart.js -->
  </div>

  <div class="vs-cart-footer">
    <div class="vs-cart-total-row">
      <span class="vs-cart-total-label">Subtotal (incl. GST):</span>
      <span class="vs-cart-total-val" id="cartTotalVal">₹0</span>
    </div>
    <button type="button" class="vs-cart-checkout-btn" id="cartCheckoutBtn">
      <span>Proceed to Checkout</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>
</aside>

{% schema %}
{
  "name": "Header & Navigation",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Brand Logo"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Vidhyut Saathi"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Solar & Electrical"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "url",
      "id": "about_link",
      "label": "About Us Page Link"
    },
    {
      "type": "url",
      "id": "products_link",
      "label": "Products Page Link"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact Us Page Link"
    },
    {
      "type": "text",
      "id": "buy_now_label",
      "label": "Buy Now Button Label",
      "default": "Buy Now"
    },
    {
      "type": "url",
      "id": "buy_now_link",
      "label": "Buy Now Link"
    },
    {
      "type": "text",
      "id": "distributor_label",
      "label": "Distributor Button Label",
      "default": "Buy Distributorship"
    },
    {
      "type": "url",
      "id": "distributor_link",
      "label": "Distributor Link"
    }
  ]
}
{% endschema %}
