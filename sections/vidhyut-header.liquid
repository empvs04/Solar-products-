{%- style -%}
  :root {
    --header-height: 92px;
  }
  #mainHeader {
    height: 92px !important;
  }
  #mainHeader .vs-logo-link {
    min-height: {{ section.settings.logo_height | default: 80 }}px;
    display: inline-flex;
    align-items: center;
  }
  #mainHeader .vs-logo-img {
    height: {{ section.settings.logo_height | default: 80 }}px !important;
    width: auto !important;
    max-width: {{ section.settings.logo_max_width | default: 320 }}px !important;
    object-fit: contain;
    image-rendering: -webkit-optimize-contrast;
  }
  #mainHeader .vs-logo-img[data-vs-auto-trim="true"]:not(.vs-logo-ready),
  #vsMobileDrawer .vs-logo-img[data-vs-auto-trim="true"]:not(.vs-logo-ready) {
    opacity: 0;
  }
  #mainHeader .vs-logo-img.vs-logo-ready,
  #vsMobileDrawer .vs-logo-img.vs-logo-ready {
    opacity: 1;
  }
  #mainHeader .vs-logo-brand,
  #mainHeader .vs-logo-text-wrap {
    display: none !important;
  }
  @media (max-width: 768px) {
    :root {
      --header-height: 80px;
    }
    #mainHeader {
      height: 80px !important;
    }
    #mainHeader .vs-logo-link {
      min-height: 66px;
    }
    #mainHeader .vs-logo-img {
      height: 66px !important;
      max-width: 240px !important;
    }
  }
  @media (max-width: 480px) {
    :root {
      --header-height: 74px;
    }
    #mainHeader {
      height: 74px !important;
    }
    #mainHeader .vs-logo-link {
      min-height: 58px;
    }
    #mainHeader .vs-logo-img {
      height: 58px !important;
      max-width: 200px !important;
    }
  }
{%- endstyle -%}

<script>
(function() {
  if (window.__vsHydrateLogo) return;
  var CACHE_PREFIX = 'vs_logo_trim_v2_';
  window.__vsTrimInFlight = window.__vsTrimInFlight || {};
  window.__vsTrimMemCache = window.__vsTrimMemCache || {};

  function cacheGet(key) {
    if (window.__vsTrimMemCache[key]) return window.__vsTrimMemCache[key];
    try {
      var raw = localStorage.getItem(CACHE_PREFIX + key);
      if (!raw) return null;
      var parsed = JSON.parse(raw);
      window.__vsTrimMemCache[key] = parsed;
      return parsed;
    } catch (e) {
      return null;
    }
  }

  function cacheSet(key, val) {
    window.__vsTrimMemCache[key] = val;
    try {
      for (var i = localStorage.length - 1; i >= 0; i--) {
        var k = localStorage.key(i);
        if (k && k.indexOf('vs_logo_trim_') === 0 && k !== CACHE_PREFIX + key) {
          localStorage.removeItem(k);
        }
      }
      localStorage.setItem(CACHE_PREFIX + key, JSON.stringify(val));
    } catch (e) {}
  }

  function finishImg(img, key, res) {
    if (!img) return;
    if (res && res.d) {
      if (res.w && res.h) {
        img.width = res.w;
        img.height = res.h;
      }
      if (img.getAttribute('src') !== res.d) {
        img.src = res.d;
      }
    }
    img.dataset.vsTrimmedSrc = key;
    img.classList.add('vs-logo-ready');
  }

  function extractTrim(sourceImg) {
    var w = sourceImg.naturalWidth;
    var h = sourceImg.naturalHeight;
    if (!w || !h || w > 3000 || h > 3000) return { n: 1 };

    var canvas = document.createElement('canvas');
    canvas.width = w;
    canvas.height = h;
    var ctx = canvas.getContext('2d', { willReadFrequently: true });
    if (!ctx) return { n: 1 };

    ctx.drawImage(sourceImg, 0, 0, w, h);
    var data = ctx.getImageData(0, 0, w, h).data;

    function cornerAt(x, y) {
      var idx = (y * w + x) * 4;
      return [data[idx], data[idx + 1], data[idx + 2], data[idx + 3]];
    }
    var c0 = cornerAt(0, 0);
    var c1 = cornerAt(w - 1, 0);
    var c2 = cornerAt(0, h - 1);
    var c3 = cornerAt(w - 1, h - 1);

    var transparentBg = c0[3] <= 10 && c1[3] <= 10 && c2[3] <= 10 && c3[3] <= 10;
    var whiteBg =
      !transparentBg &&
      c0[3] >= 245 && c0[0] >= 250 && c0[1] >= 250 && c0[2] >= 250 &&
      c1[3] >= 245 && c1[0] >= 250 && c1[1] >= 250 && c1[2] >= 250 &&
      c2[3] >= 245 && c2[0] >= 250 && c2[1] >= 250 && c2[2] >= 250 &&
      c3[3] >= 245 && c3[0] >= 250 && c3[1] >= 250 && c3[2] >= 250;

    if (!transparentBg && !whiteBg) return { n: 1 };

    function isBg(idx) {
      if (data[idx + 3] <= 10) return true;
      if (whiteBg && data[idx] >= 248 && data[idx + 1] >= 248 && data[idx + 2] >= 248) return true;
      return false;
    }

    var minX = w, minY = h, maxX = -1, maxY = -1;
    for (var y = 0; y < h; y++) {
      var rowOffset = y * w;
      for (var x = 0; x < w; x++) {
        var idx = (rowOffset + x) * 4;
        if (!isBg(idx)) {
          if (x < minX) minX = x;
          if (x > maxX) maxX = x;
          if (y < minY) minY = y;
          if (y > maxY) maxY = y;
        }
      }
    }

    if (maxX < minX || maxY < minY) return { n: 1 };
    var trimW = maxX - minX + 1;
    var trimH = maxY - minY + 1;
    if (trimW < 20 || trimH < 20) return { n: 1 };
    if (trimW >= w * 0.90 && trimH >= h * 0.90) return { n: 1 };

    var outW = trimW;
    var outH = trimH;
    if (outW > 800) {
      outH = Math.max(20, Math.round(trimH * (800 / trimW)));
      outW = 800;
    }

    var outCanvas = document.createElement('canvas');
    outCanvas.width = outW;
    outCanvas.height = outH;
    var outCtx = outCanvas.getContext('2d');
    if (!outCtx) return { n: 1 };
    outCtx.drawImage(sourceImg, minX, minY, trimW, trimH, 0, 0, outW, outH);

    return {
      d: outCanvas.toDataURL('image/png'),
      w: trimW,
      h: trimH
    };
  }

  window.__vsHydrateLogo = function(img) {
    if (!img || !img.getAttribute('data-vs-auto-trim')) return;
    var rawSrc = img.getAttribute('src') || '';
    if (!rawSrc || rawSrc.indexOf('data:') === 0 || /\.svg(\?|$)/i.test(rawSrc)) {
      img.classList.add('vs-logo-ready');
      return;
    }

    var absSrc = rawSrc;
    try {
      absSrc = new URL(rawSrc, window.location.href).href;
    } catch (e) {}

    if (img.dataset.vsTrimmedSrc === absSrc && img.classList.contains('vs-logo-ready')) return;

    var cached = cacheGet(absSrc);
    if (cached) {
      finishImg(img, absSrc, cached);
      return;
    }

    var timer = window.setTimeout(function() {
      img.classList.add('vs-logo-ready');
    }, 1500);

    function settle(res) {
      window.clearTimeout(timer);
      finishImg(img, absSrc, res);
    }

    if (window.__vsTrimInFlight[absSrc]) {
      window.__vsTrimInFlight[absSrc].push(settle);
      return;
    }
    window.__vsTrimInFlight[absSrc] = [settle];

    function resolveAll(res, shouldCache) {
      if (shouldCache) {
        cacheSet(absSrc, res);
      }
      var list = window.__vsTrimInFlight[absSrc] || [];
      delete window.__vsTrimInFlight[absSrc];
      for (var i = 0; i < list.length; i++) {
        list[i](res);
      }
    }

    var sameOrigin = false;
    try {
      sameOrigin = new URL(absSrc).origin === window.location.origin;
    } catch (e) {}

    if (sameOrigin) {
      function handleSameOrigin() {
        try {
          resolveAll(extractTrim(img), true);
        } catch (err) {
          resolveAll({ n: 1 }, false);
        }
      }
      if (img.complete && img.naturalWidth > 0) {
        handleSameOrigin();
      } else {
        img.addEventListener('load', handleSameOrigin, { once: true });
        img.addEventListener('error', function() { resolveAll({ n: 1 }, false); }, { once: true });
      }
    } else {
      var probe = new Image();
      probe.crossOrigin = 'anonymous';
      probe.onload = function() {
        try {
          resolveAll(extractTrim(probe), true);
        } catch (err) {
          resolveAll({ n: 1 }, false);
        }
      };
      probe.onerror = function() {
        resolveAll({ n: 1 }, false);
      };
      probe.src = absSrc + (absSrc.indexOf('?') > -1 ? '&' : '?') + '_vsc=1';
    }
  };
})();
</script>

<header class="vs-header" id="mainHeader">
  <div class="vs-container">
    <div class="vs-header-inner">
      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="vs-logo-link" aria-label="Vidhyut Saathi Home">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 1200 }}"
            alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
            class="vs-logo-img"
            width="{{ section.settings.logo.width | default: 160 }}"
            height="{{ section.settings.logo.height | default: 80 }}"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
            data-vs-auto-trim="true"
          >
          <script>window.__vsHydrateLogo&&window.__vsHydrateLogo(document.currentScript.previousElementSibling);</script>
        {% else %}
          <img
            src="{{ 'vidhyut-logo-brand-hd.png' | asset_url }}"
            alt="Vidhyut Saathi Logo"
            class="vs-logo-img"
            width="160"
            height="80"
            loading="eager"
            fetchpriority="high"
          >
        {% endif %}
      </a>

      <!-- Desktop Navigation -->
      <nav class="vs-nav-desktop" aria-label="Main Navigation">
        <ul class="vs-nav-list">
          {%- liquid
            assign base_root = routes.root_url
            if base_root == '/'
              assign base_root = ''
            endif

            if section.settings.about_link != blank
              assign about_page_url = section.settings.about_link
            elsif pages['about-us'].url != blank
              assign about_page_url = pages['about-us'].url
            elsif pages['about'].url != blank
              assign about_page_url = pages['about'].url
            else
              assign about_page_url = base_root | append: '/pages/about-us'
            endif

            if section.settings.products_link != blank
              assign products_page_url = section.settings.products_link
            elsif pages['products'].url != blank
              assign products_page_url = pages['products'].url
            elsif pages['our-products'].url != blank
              assign products_page_url = pages['our-products'].url
            elsif pages['all-products'].url != blank
              assign products_page_url = pages['all-products'].url
            elsif pages['product'].url != blank
              assign products_page_url = pages['product'].url
            elsif routes.all_products_collection_url != blank
              assign products_page_url = routes.all_products_collection_url
            else
              assign products_page_url = base_root | append: '/pages/products'
            endif

            if section.settings.contact_link != blank
              assign contact_page_url = section.settings.contact_link
            elsif pages['contact-us'].url != blank
              assign contact_page_url = pages['contact-us'].url
            elsif pages['contact'].url != blank
              assign contact_page_url = pages['contact'].url
            else
              assign contact_page_url = base_root | append: '/pages/contact-us'
            endif

            if section.settings.distributor_link != blank
              assign distributor_page_url = section.settings.distributor_link
            elsif pages['buy-distributorship'].url != blank
              assign distributor_page_url = pages['buy-distributorship'].url
            elsif pages['distributorship'].url != blank
              assign distributor_page_url = pages['distributorship'].url
            elsif pages['get-franchise'].url != blank
              assign distributor_page_url = pages['get-franchise'].url
            else
              assign distributor_page_url = base_root | append: '/pages/buy-distributorship'
            endif

            if section.settings.buy_now_link != blank
              assign buy_now_page_url = section.settings.buy_now_link
            elsif pages['buy-now'].url != blank
              assign buy_now_page_url = pages['buy-now'].url
            elsif pages['buynow'].url != blank
              assign buy_now_page_url = pages['buynow'].url
            else
              assign buy_now_page_url = base_root | append: '/pages/buy-now'
            endif

            assign menu_has_about = false
            if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0
              for l in linklists[section.settings.menu].links
                assign l_clean = l.title | downcase | strip
                if l_clean contains 'about'
                  assign menu_has_about = true
                endif
              endfor
            endif
          -%}

          {%- if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 -%}
            {%- for link in linklists[section.settings.menu].links -%}
              {%- assign link_title_clean = link.title | strip -%}
              {%- assign link_title_downcase = link_title_clean | downcase -%}

              {%- if link_title_downcase == 'home' -%}
                <li>
                  <a
                    href="{{ link.url }}"
                    class="vs-nav-link {% if link.active or template.name == 'index' %}is-active{% endif %}"
                  >
                    Home
                  </a>
                </li>
                {%- unless menu_has_about -%}
                  <li>
                    <a
                      href="{{ about_page_url }}"
                      class="vs-nav-link {% if page.handle == 'about-us' or template.suffix == 'about-us' %}is-active{% endif %}"
                    >
                      About Us
                    </a>
                  </li>
                {%- endunless -%}

              {%- elsif link_title_downcase == 'about' or link_title_downcase == 'about us' -%}
                <li>
                  <a
                    href="{{ link.url | default: about_page_url }}"
                    class="vs-nav-link {% if link.active or page.handle == 'about-us' or template.suffix == 'about-us' %}is-active{% endif %}"
                  >
                    About Us
                  </a>
                </li>

              {%- elsif link_title_downcase == 'catalog' or link_title_downcase == 'catalogue' or link_title_downcase == 'products' or link.url == '/collections/all' or link.url contains '#products' -%}
                {%- liquid
                  if link.url contains '#products' or link.url == '/' or link.url == routes.root_url or link.url == '/collections/all'
                    assign nav_product_href = products_page_url
                  else
                    assign nav_product_href = link.url | default: products_page_url
                  endif
                -%}
                <li>
                  <a
                    href="{{ nav_product_href }}"
                    class="vs-nav-link {% if link.active or page.handle == 'products' or page.handle == 'our-products' or page.handle == 'all-products' or template.suffix == 'products' or template.name == 'collection' %}is-active{% endif %}"
                  >
                    Products
                  </a>
                </li>

              {%- elsif link_title_downcase == 'contact us' or link_title_downcase == 'contact' -%}
                <li>
                  <a
                    href="{{ link.url | default: contact_page_url }}"
                    class="vs-nav-link {% if link.active or page.handle == 'contact' or page.handle == 'contact-us' or template.suffix == 'contact' or template.suffix == 'contact-us' or template.name == 'page' and page.handle contains 'contact' %}is-active{% endif %}"
                  >
                    Contact
                  </a>
                </li>

              {%- else -%}
                <li>
                  <a
                    href="{{ link.url }}"
                    class="vs-nav-link {% if link.active or link.child_active %}is-active{% endif %}"
                  >
                    {{ link.title }}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.root_url }}" class="vs-nav-link {% if template.name == 'index' %}is-active{% endif %}">Home</a></li>
            <li><a href="{{ about_page_url }}" class="vs-nav-link {% if page.handle == 'about-us' or template.suffix == 'about-us' %}is-active{% endif %}">About Us</a></li>
            <li><a href="{{ products_page_url }}" class="vs-nav-link {% if page.handle == 'products' or page.handle == 'our-products' or page.handle == 'all-products' or template.suffix == 'products' or template.name == 'collection' %}is-active{% endif %}">Products</a></li>
            <li><a href="{{ contact_page_url }}" class="vs-nav-link {% if page.handle == 'contact' or page.handle == 'contact-us' or template.suffix == 'contact' or template.suffix == 'contact-us' or template.name == 'page' and page.handle contains 'contact' %}is-active{% endif %}">Contact</a></li>
          {%- endif -%}
        </ul>
      </nav>

      <!-- Desktop CTA Action Buttons -->
      <div class="vs-header-actions">
        <a
          href="{{ buy_now_page_url }}"
          class="vs-btn vs-btn-accent vs-btn-buynow {% if page.handle == 'buy-now' or template.suffix == 'buy-now' %}is-active{% endif %}"
          id="headerBuyNowBtn"
          aria-label="Shopping Cart & Buy Now"
        >
          <svg class="vs-cart-btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          <span>{{ section.settings.buy_now_label | default: 'Buy Now' }}</span>
          <span class="vs-navbar-cart-count" id="navbarCartBadge">0</span>
        </a>
        <a
          href="{{ distributor_page_url }}"
          class="vs-btn vs-btn-outline {% if page.handle == 'buy-distributorship' or page.handle == 'distributorship' or page.handle == 'get-franchise' or template.suffix == 'buy-distributorship' or template.suffix == 'distributorship' or template.suffix == 'get-franchise' %}is-active{% endif %}"
          id="headerDistributorBtn"
        >
          {{ section.settings.distributor_label | default: 'Buy Distributorship' }}
        </a>
      </div>

      <!-- Mobile Hamburger Toggle -->
      <button
        type="button"
        class="vs-nav-toggle"
        id="vsNavToggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="vsMobileDrawer"
      >
        <span class="vs-hamburger-bar"></span>
        <span class="vs-hamburger-bar"></span>
        <span class="vs-hamburger-bar"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Drawer Backdrop -->
<div class="vs-nav-backdrop" id="vsNavBackdrop" style="display: none; visibility: hidden;"></div>

<!-- Mobile Navigation Drawer -->
<div class="vs-mobile-drawer" id="vsMobileDrawer" role="dialog" aria-modal="true" aria-label="Navigation Menu" style="display: none; visibility: hidden;">
  <div class="vs-mobile-drawer-header">
    <div class="vs-logo-link">
      {% if section.settings.logo != blank %}
        <img
          src="{{ section.settings.logo | image_url: width: 1200 }}"
          alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
          class="vs-logo-img"
          width="{{ section.settings.logo.width | default: 116 }}"
          height="{{ section.settings.logo.height | default: 58 }}"
          loading="eager"
          decoding="sync"
          data-vs-auto-trim="true"
        >
        <script>window.__vsHydrateLogo&&window.__vsHydrateLogo(document.currentScript.previousElementSibling);</script>
      {% else %}
        <img
          src="{{ 'vidhyut-logo-brand-hd.png' | asset_url }}"
          alt="Vidhyut Saathi Logo"
          class="vs-logo-img"
          width="116"
          height="58"
          loading="lazy"
        >
      {% endif %}
    </div>
    <button
      type="button"
      class="vs-mobile-close-btn"
      id="vsMobileCloseBtn"
      aria-label="Close menu"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <ul class="vs-mobile-nav-list">
    {%- if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 -%}
      {%- for link in linklists[section.settings.menu].links -%}
        {%- assign link_title_clean = link.title | strip -%}
        {%- assign link_title_downcase = link_title_clean | downcase -%}

        {%- if link_title_downcase == 'home' -%}
          <li>
            <a
              href="{{ link.url }}"
              class="vs-mobile-nav-link {% if link.active or template.name == 'index' %}is-active{% endif %}"
            >
              <span>Home</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </li>
          {%- unless menu_has_about -%}
            <li>
              <a
                href="{{ about_page_url }}"
                class="vs-mobile-nav-link {% if page.handle == 'about-us' or template.suffix == 'about-us' %}is-active{% endif %}"
              >
                <span>About Us</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
            </li>
          {%- endunless -%}

        {%- elsif link_title_downcase == 'about' or link_title_downcase == 'about us' -%}
          <li>
            <a
              href="{{ link.url | default: about_page_url }}"
              class="vs-mobile-nav-link {% if link.active or page.handle == 'about-us' or template.suffix == 'about-us' %}is-active{% endif %}"
            >
              <span>About Us</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </li>

        {%- elsif link_title_downcase == 'catalog' or link_title_downcase == 'catalogue' or link_title_downcase == 'products' or link.url == '/collections/all' or link.url contains '#products' -%}
          {%- liquid
            if link.url contains '#products' or link.url == '/' or link.url == routes.root_url or link.url == '/collections/all'
              assign mob_product_href = products_page_url
            else
              assign mob_product_href = link.url | default: products_page_url
            endif
          -%}
          <li>
            <a
              href="{{ mob_product_href }}"
              class="vs-mobile-nav-link {% if link.active or page.handle == 'products' or page.handle == 'our-products' or page.handle == 'all-products' or template.suffix == 'products' or template.name == 'collection' %}is-active{% endif %}"
            >
              <span>Products</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </li>

        {%- elsif link_title_downcase == 'contact us' or link_title_downcase == 'contact' -%}
          <li>
            <a
              href="{{ link.url | default: contact_page_url }}"
              class="vs-mobile-nav-link {% if link.active or page.handle == 'contact' or page.handle == 'contact-us' or template.suffix == 'contact' or template.suffix == 'contact-us' or template.name == 'page' and page.handle contains 'contact' %}is-active{% endif %}"
            >
              <span>Contact</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </li>

        {%- else -%}
          <li>
            <a
              href="{{ link.url }}"
              class="vs-mobile-nav-link {% if link.active or link.child_active %}is-active{% endif %}"
            >
              <span>{{ link.title }}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <li>
        <a href="{{ routes.root_url }}" class="vs-mobile-nav-link {% if template.name == 'index' %}is-active{% endif %}">
          <span>Home</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </li>
      <li>
        <a href="{{ about_page_url }}" class="vs-mobile-nav-link {% if page.handle == 'about-us' or template.suffix == 'about-us' %}is-active{% endif %}">
          <span>About Us</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </li>
      <li>
        <a href="{{ products_page_url }}" class="vs-mobile-nav-link {% if page.handle == 'products' or page.handle == 'our-products' or page.handle == 'all-products' or template.suffix == 'products' or template.name == 'collection' %}is-active{% endif %}">
          <span>Products</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </li>
      <li>
        <a href="{{ contact_page_url }}" class="vs-mobile-nav-link {% if page.handle == 'contact' or page.handle == 'contact-us' or template.suffix == 'contact' or template.suffix == 'contact-us' or template.name == 'page' and page.handle contains 'contact' %}is-active{% endif %}">
          <span>Contact</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </li>
    {%- endif -%}
  </ul>

  <div class="vs-mobile-actions">
    <a
      href="{{ buy_now_page_url }}"
      class="vs-btn vs-btn-accent vs-btn-buynow {% if page.handle == 'buy-now' or template.suffix == 'buy-now' %}is-active{% endif %}"
      id="mobileBuyNowBtn"
      aria-label="Shopping Cart & Buy Now"
    >
      <svg class="vs-cart-btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
      <span>{{ section.settings.buy_now_label | default: 'Buy Now' }}</span>
      <span class="vs-navbar-cart-count" id="mobileNavbarCartBadge">0</span>
    </a>
    <a
      href="{{ distributor_page_url }}"
      class="vs-btn vs-btn-outline {% if page.handle == 'buy-distributorship' or page.handle == 'distributorship' or page.handle == 'get-franchise' or template.suffix == 'buy-distributorship' or template.suffix == 'distributorship' or template.suffix == 'get-franchise' %}is-active{% endif %}"
      id="mobileDistributorBtn"
    >
      {{ section.settings.distributor_label | default: 'Buy Distributorship' }}
    </a>
    <div class="vs-mobile-contact-snippet">
      Direct Inquiries: <a href="tel:+918199036060">+91-8199036060</a>
    </div>
  </div>
</div>

<!-- Global Shopping Cart Slide-Over Drawer -->
<div class="vs-cart-drawer-backdrop" id="cartDrawerBackdrop" style="display: none; visibility: hidden;"></div>
<aside class="vs-cart-drawer" id="cartDrawer" aria-label="Shopping Cart Drawer" style="display: none; visibility: hidden;">
  <div class="vs-cart-header">
    <div class="vs-cart-title-wrap">
      <h3 class="vs-cart-title">Shopping Cart <span class="vs-cart-title-count" id="cartBadgeCount">(0)</span></h3>
    </div>
    <button type="button" class="vs-cart-close" id="cartDrawerClose" aria-label="Close cart drawer">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>

  <!-- Sale Urgency Bar -->
  <div class="vs-cart-urgency-bar" id="cartUrgencyBar">
    <span class="vs-cart-urgency-icon">⚡</span>
    <span class="vs-cart-urgency-text">Sale ends in : <strong class="vs-cart-timer" id="cartTimer">12h : 08m : 44s</strong></span>
  </div>

  <!-- Scrollable Drawer Body -->
  <div class="vs-cart-body" id="cartDrawerBody">
    <div class="vs-cart-items-wrap" id="cartItemsWrap">
      <!-- Populated dynamically via vidhyut-cart.js -->
    </div>

    <!-- Extra Widgets -->
    <div class="vs-cart-extra-widgets" id="cartExtraWidgets">
      <!-- 7-Days Free Return & Exchange Available -->
      <div class="vs-cart-trust-pill">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M3 21v-5h5"></path></svg>
        <span>7-Days Free Return &amp; Exchange Available</span>
      </div>

      <!-- Offers Available Accordion -->
      <div class="vs-cart-coupon-box" id="cartCouponBox">
        <button type="button" class="vs-cart-coupon-header" id="cartCouponToggle" aria-expanded="false">
          <div class="vs-cart-coupon-left">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
            <span>Offers Available</span>
          </div>
          <div class="vs-cart-coupon-right">
            <span>View all coupons</span>
            <svg class="vs-chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </div>
        </button>
        <div class="vs-cart-coupon-content" id="cartCouponContent" style="display: none;">
          <div class="vs-coupon-input-row">
            <input type="text" id="couponCodeInput" placeholder="Enter coupon code (e.g. FREESHIP)" class="vs-coupon-input">
            <button type="button" id="applyCouponBtn" class="vs-coupon-apply-btn">Apply</button>
          </div>
          <div class="vs-coupon-list">
            <div class="vs-coupon-item">
              <div>
                <span class="vs-coupon-code-badge">FREESHIP</span>
                <span class="vs-coupon-desc">Free Fast Delivery Pan-India</span>
              </div>
              <span class="vs-coupon-active-badge">Auto Applied ✓</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 100% Secure Transaction Box -->
      <div class="vs-cart-secure-box">
        <div class="vs-cart-secure-title">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <span>100% secure transaction</span>
        </div>
        <div class="vs-cart-payment-badges">
          <img
            src="{{ 'payment-trust-badges.png' | asset_url }}"
            alt="100% Secure Transaction: GPay, Paytm, PhonePe, VISA, RuPay, LazyPay, Mastercard, Amazon Pay"
            class="vs-payment-badges-img"
            width="292"
            height="24"
            loading="lazy"
          >
        </div>
      </div>

      <!-- Order Summary Accordion -->
      <div class="vs-cart-summary-accordion" id="cartSummaryAccordion">
        <button type="button" class="vs-summary-toggle" id="summaryToggle" aria-expanded="false">
          <strong>Order Summary</strong>
          <svg class="vs-summary-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="vs-summary-details" id="summaryDetails" style="display: none;">
          <div class="vs-summary-row">
            <span>Bag Total (MRP)</span>
            <span id="summaryMrpVal">₹0</span>
          </div>
          <div class="vs-summary-row vs-text-discount">
            <span>Bag Savings</span>
            <span id="summaryDiscountVal">-₹0</span>
          </div>
          <div class="vs-summary-row" id="summaryCouponRow">
            <span>Coupon Discount</span>
            <span id="summaryCouponVal" class="vs-text-muted">No coupon applied</span>
          </div>
          <div class="vs-summary-row">
            <span>Delivery Fee</span>
            <span class="vs-text-green">FREE</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Fixed / Sticky Footer Bar -->
  <div class="vs-cart-footer" id="cartDrawerFooter">
    <div class="vs-cart-footer-left">
      <span class="vs-cart-footer-price" id="cartTotalVal">Rs. 0.00</span>
      <span class="vs-cart-footer-label">Total payable</span>
    </div>
    <button type="button" class="vs-cart-proceed-btn" id="cartCheckoutBtn">
      <span>PROCEED TO BUY</span>
    </button>
  </div>
</aside>

<script>
(function() {
  function initHeaderLogos() {
    if (!window.__vsHydrateLogo) return;
    var imgs = document.querySelectorAll('#mainHeader .vs-logo-img[data-vs-auto-trim="true"], #vsMobileDrawer .vs-logo-img[data-vs-auto-trim="true"]');
    for (var i = 0; i < imgs.length; i++) {
      window.__vsHydrateLogo(imgs[i]);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderLogos);
  } else {
    initHeaderLogos();
  }
  document.addEventListener('shopify:section:load', initHeaderLogos);
})();
</script>

{% schema %}
{
  "name": "Header & Navigation",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Brand Logo"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Logo Height (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 100,
      "max": 360,
      "step": 10,
      "unit": "px",
      "label": "Logo Max Width (Desktop)",
      "default": 320
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Vidhyut Saathi"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "url",
      "id": "about_link",
      "label": "About Us Page Link"
    },
    {
      "type": "url",
      "id": "products_link",
      "label": "Products Page Link"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact Us Page Link"
    },
    {
      "type": "text",
      "id": "buy_now_label",
      "label": "Buy Now Button Label",
      "default": "Buy Now"
    },
    {
      "type": "url",
      "id": "buy_now_link",
      "label": "Buy Now Link"
    },
    {
      "type": "text",
      "id": "distributor_label",
      "label": "Distributor Button Label",
      "default": "Buy Distributorship"
    },
    {
      "type": "url",
      "id": "distributor_link",
      "label": "Distributor Link"
    }
  ]
}
{% endschema %}
