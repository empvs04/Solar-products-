      "label": "Custom Brand Logo"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Logo Height (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 100,
      "max": 360,
      "step": 10,
      "unit": "px",
      "label": "Logo Max Width (Desktop)",
      "default": 320
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Vidhyut Saathi"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "url",
      "id": "about_link",
      "label": "About Us Page Link"
    },
    {
      "type": "url",
      "id": "products_link",
      "label": "Products Page Link"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact Us Page Link"
    },
    {
      "type": "text",
      "id": "buy_now_label",
      "label": "Buy Now Button Label",
      "default": "Buy Now"
    },
    {
      "type": "url",
      "id": "buy_now_link",
      "label": "Buy Now Link"
    },
    {
