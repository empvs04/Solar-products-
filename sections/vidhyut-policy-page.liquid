{{ 'vidhyut-policy-modal.css' | asset_url | stylesheet_tag }}

{% assign policy_type = section.settings.policy_type | default: 'auto' %}
{% if policy_type == 'auto' %}
  {% if page.handle contains 'privacy' %}
    {% assign policy_type = 'privacy' %}
  {% elsif page.handle contains 'refund' or page.handle contains 'return' %}
    {% assign policy_type = 'refund' %}
  {% elsif page.handle contains 'terms' %}
    {% assign policy_type = 'terms' %}
  {% elsif page.handle contains 'disclaimer' %}
    {% assign policy_type = 'disclaimer' %}
  {% endif %}
{% endif %}

<!-- ======================================================================
     Page Banner & Breadcrumb
     ====================================================================== -->
<header class="vs-policy-page-header">
  <div class="vs-container">
    <nav class="vs-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="vs-breadcrumb-sep">/</span>
      <span class="vs-breadcrumb-sep">Legal</span>
      <span class="vs-breadcrumb-sep">/</span>
      <span aria-current="page">{{ page.title | default: section.settings.page_title }}</span>
    </nav>
    <h1 class="vs-page-title">
      {% if section.settings.page_title != blank %}
        {{ section.settings.page_title }}
      {% elsif page.title != blank %}
        {{ page.title }}
      {% else %}
        Legal Information
      {% endif %}
    </h1>
    {% if section.settings.page_subtitle != blank %}
      <p class="vs-page-intro-sub">{{ section.settings.page_subtitle }}</p>
    {% endif %}
  </div>
</header>

<!-- ======================================================================
     Section: Policy Document Card
     ====================================================================== -->
<section class="vs-policy-page-section">
  <div class="vs-container">
    <article class="vs-policy-card">
      {% if page.content != blank %}
        <div class="vs-policy-custom-content">
          {{ page.content }}
        </div>
      {% elsif policy_type == 'privacy' %}
        <div class="vs-policy-meta-bar">
  <p><strong>Website:</strong> <a href="https://vidhyutsaathi.in/" target="_blank" rel="noopener noreferrer">https://vidhyutsaathi.in/</a></p>
  <p><strong>Brand:</strong> Vidhyut Saathi</p>
  <p><strong>Effective Date:</strong> 10 November 2026</p>
