{% comment %}
  Vidhyut Saathi - Top Marquee Ticker Section
  Continuous right-to-left scrolling announcement bar.
  Color scheme: #c4a159 with crisp white text & vector icons.
{% endcomment %}

<div class="vs-ticker-wrap" id="vsTopTicker" role="region" aria-label="Announcement Ticker">
