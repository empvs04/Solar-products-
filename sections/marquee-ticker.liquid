        <span class="vs-ticker-item">
          <svg class="vs-ticker-svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg>
          <span class="vs-ticker-text">INDIA'S NO-1 ELECTRIC SAVER CARD</span>
        </span>
        <span class="vs-ticker-dot" aria-hidden="true">•</span>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .vs-ticker-wrap {
    width: 100%;
    overflow: hidden;
    white-space: nowrap;
    background: {{ section.settings.bg_color | default: '#c4a159' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    height: 38px;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 1050;
    user-select: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .vs-ticker-track {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
    animation: vsMarqueeScroll 28s linear infinite;
  }

  .vs-ticker-wrap:hover .vs-ticker-track {
    animation-play-state: paused;
  }

  .vs-ticker-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .vs-ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 22px;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: inherit;
  }

  .vs-ticker-svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    fill: currentColor;
    display: inline-block;
    vertical-align: middle;
  }

  .vs-ticker-icon {
    font-size: 1rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }

  .vs-ticker-dot {
    color: rgba(255, 255, 255, 0.45);
    font-size: 1rem;
    margin: 0 4px;
  }

  @keyframes vsMarqueeScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .vs-ticker-wrap {
      height: 34px;
    }
    .vs-ticker-item {
      padding: 0 14px;
      font-size: 0.75rem;
      gap: 6px;
    }
    .vs-ticker-svg {
      width: 14px;
      height: 14px;
    }
    .vs-ticker-track {
      animation-duration: 22s;
    }
  }
</style>

{% schema %}
{
  "name": "Announcement Ticker",
  "tag": "div",
  "class": "section-marquee-ticker",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#c4a159"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 15,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Scroll Speed",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "ticker_item",
      "name": "Ticker Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Emoji)",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Announcement Text",
          "default": "FREE SHIPPING ON ALL PREPAID ORDERS ABOVE RS1500"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Ticker",
      "blocks": [
        {
          "type": "ticker_item",
          "settings": {
            "icon": "🚚",
            "text": "FREE SHIPPING ON ALL PREPAID ORDERS ABOVE RS1500"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "icon": "🛡️",
            "text": "CASH ON DELIVERY ALSO AVAILABLE"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "icon": "🏷️",
            "text": "BUY MULTI-PACK COMBOS & SAVE UP TO 30%"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "icon": "⚡",
            "text": "INDIA'S BEST MECO CLAMP METER"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "icon": "💳",
            "text": "INDIA'S NO-1 ELECTRIC SAVER CARD"
          }
        }
      ]
    }
  ]
}
{% endschema %}
