    <!-- Track Loop 2 (Seamless Infinite Repeat) -->
    <div class="vs-ticker-group" aria-hidden="true">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <span class="vs-ticker-item">
            {% if block.settings.icon != blank %}
              <span class="vs-ticker-icon">{{ block.settings.icon }}</span>
