          <span class="vs-ticker-text">FREE SHIPPING ON ALL PREPAID ORDERS ABOVE RS1500</span>
        </span>
        <span class="vs-ticker-dot" aria-hidden="true">•</span>

        <!-- Item 2: Cash On Delivery -->
