{{ 'vidhyut-about-page.css' | asset_url | stylesheet_tag }}

<!-- ======================================================================
     Page Banner & Breadcrumb
     ====================================================================== -->
<header class="vs-page-banner">
  <div class="vs-container">
    <nav class="vs-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="vs-breadcrumb-sep">/</span>
      <span aria-current="page">About Us</span>
    </nav>
    <h1 class="vs-page-title">{{ section.settings.page_title | default: 'About Us' }}</h1>
    <p class="vs-page-intro-sub">{{ section.settings.page_subtitle | default: 'Smarter energy choices for homes, businesses, and channel partners across India.' }}</p>
  </div>
</header>

<!-- ======================================================================
     Section A: About Us Introduction
     ====================================================================== -->
<section class="vs-about-intro-section" id="about-intro">
  <div class="vs-container">
    <div class="vs-about-intro-grid">
      <div class="vs-about-intro-text">
        <div class="vs-section-badge">About Vidhyut Saathi</div>
        <p class="vs-about-lead-para">
          At Vidhyut Saathi, we believe that smarter energy choices create a brighter and more sustainable future. We are committed to making energy-efficient electrical and solar products accessible to both individual customers and businesses, helping them discover practical solutions for their everyday energy needs.
        </p>
        <p class="vs-about-body-para">
          From homes looking for efficient lighting to businesses seeking dependable products for commercial use, retail, and bulk purchasing, Vidhyut Saathi aims to serve a diverse range of customers with solutions designed for modern energy requirements.
        </p>
        <p class="vs-about-portfolio-para">
          Our product portfolio includes solar lights, LED lights, LED bulbs, clamp meters, solar chargers, smart power strips, and a growing range of energy-saving and electrical products.
        </p>
      </div>

      <div class="vs-about-intro-media">
        <div class="vs-about-intro-frame">
          <img
            src="{{ 'brand-intro.jpg' | asset_url }}"
            alt="Vidhyut Saathi clean energy and modern electrical lighting solutions"
            class="vs-about-intro-img"
            loading="lazy"
            width="800"
            height="600"
          >
        </div>
        <div class="vs-about-intro-badge">
          <div class="vs-about-intro-badge-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
            </svg>
          </div>
          <div class="vs-about-intro-badge-text">
            <b>Smarter Energy Choices</b>
            <span>Practical Everyday Reliability</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ======================================================================
     Section B: What We Do
     ====================================================================== -->
<section class="vs-what-we-do-section" id="what-we-do">
  <div class="vs-container">
    <header class="vs-section-header">
      <div class="vs-section-badge">Our Commitment</div>
      <h2 class="vs-section-title">What We Do</h2>
      <p class="vs-section-subtitle">
        We serve both retail and business customers with products that support energy efficiency, convenience, and smarter electricity management.
      </p>
    </header>

    <div class="vs-customer-grid">
      <!-- Card 1: B2C -->
      <div class="vs-customer-card">
        <div class="vs-customer-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
        </div>
        <h3 class="vs-customer-title">For Homes &amp; Individual Customers (B2C):</h3>
        <p class="vs-customer-desc">
          Discover energy-saving lighting, solar-powered products, and smart electrical accessories for everyday use.
        </p>
      </div>

      <!-- Card 2: B2B -->
      <div class="vs-customer-card">
        <div class="vs-customer-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
        </div>
        <h3 class="vs-customer-title">For Businesses &amp; Bulk Buyers (B2B):</h3>
        <p class="vs-customer-desc">
          Explore product solutions for offices, commercial establishments, retailers, distributors, and other business requirements.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ======================================================================
     Section C: Our Product Range
     ====================================================================== -->
<section class="vs-product-range-section" id="product-range">
  <div class="vs-container">
    <header class="vs-section-header">
      <div class="vs-section-badge">Comprehensive Solutions</div>
      <h2 class="vs-section-title">Our Product Range</h2>
      <p class="vs-section-subtitle">
        From energy-efficient LED lighting to solar-powered solutions and electrical measuring instruments, we bring together products that support a wide variety of residential and commercial applications.
      </p>
    </header>

    <div class="vs-range-grid">
      <!-- Item 1: Solar Lighting Solutions -->
      <div class="vs-range-card">
        <div class="vs-range-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </div>
        <h3 class="vs-range-title">Solar Lighting Solutions</h3>
        <p class="vs-range-desc">Solar-powered lighting for suitable indoor and outdoor applications.</p>
      </div>

      <!-- Item 2: LED Lights & Bulbs -->
      <div class="vs-range-card">
        <div class="vs-range-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18h6"></path>
            <path d="M10 22h4"></path>
            <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"></path>
          </svg>
        </div>
        <h3 class="vs-range-title">LED Lights &amp; Bulbs</h3>
        <p class="vs-range-desc">Energy-efficient lighting for homes, offices, shops, and commercial spaces.</p>
      </div>

      <!-- Item 3: Clamp Meters & Electrical Tools -->
      <div class="vs-range-card">
        <div class="vs-range-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
          </svg>
        </div>
        <h3 class="vs-range-title">Clamp Meters &amp; Electrical Tools</h3>
        <p class="vs-range-desc">Useful instruments for electrical measurement and maintenance.</p>
      </div>

      <!-- Item 4: Solar Chargers -->
      <div class="vs-range-card">
        <div class="vs-range-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
            <line x1="12" y1="18" x2="12.01" y2="18"></line>
            <path d="M11 6l2 4h-3l2 4"></path>
          </svg>
        </div>
        <h3 class="vs-range-title">Solar Chargers</h3>
        <p class="vs-range-desc">Convenient solar-powered charging solutions.</p>
      </div>

      <!-- Item 5: Smart Power Strips -->
      <div class="vs-range-card">
        <div class="vs-range-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="6" width="20" height="12" rx="2"></rect>
            <circle cx="6" cy="12" r="1.5"></circle>
            <circle cx="12" cy="12" r="1.5"></circle>
            <circle cx="18" cy="12" r="1.5"></circle>
          </svg>
        </div>
        <h3 class="vs-range-title">Smart Power Strips</h3>
        <p class="vs-range-desc">Power management accessories for connected devices.</p>
      </div>

      <!-- Item 6: Other Energy-Saving Products -->
      <div class="vs-range-card">
        <div class="vs-range-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
        <h3 class="vs-range-title">Other Energy-Saving Products</h3>
        <p class="vs-range-desc">Practical solutions to support more efficient energy use.</p>
      </div>
    </div>
  </div>
</section>

<!-- ======================================================================
     Section D: Why Choose Vidhyut Saathi?
     ====================================================================== -->
<section class="vs-why-about-section" id="why-choose">
  <div class="vs-container">
    <header class="vs-section-header">
      <div class="vs-section-badge">Core Advantages</div>
      <h2 class="vs-section-title">Why Choose Vidhyut Saathi?</h2>
      <p class="vs-section-subtitle">
        Focused on providing dependable energy-saving solutions tailored to Indian everyday applications.
      </p>
    </header>

    <div class="vs-why-cards-grid">
      <!-- Benefit 1 -->
      <div class="vs-why-item-card">
        <div class="vs-why-number">01</div>
        <h3 class="vs-why-item-title">Solutions for Every Customer</h3>
        <p class="vs-why-item-desc">
          We cater to individual buyers as well as businesses with different product needs and purchasing requirements.
        </p>
      </div>

      <!-- Benefit 2 -->
      <div class="vs-why-item-card">
        <div class="vs-why-number">02</div>
        <h3 class="vs-why-item-title">A Diverse Product Portfolio</h3>
        <p class="vs-why-item-desc">
          We bring multiple energy-saving and electrical product categories together in one place.
        </p>
      </div>

      <!-- Benefit 3 -->
      <div class="vs-why-item-card">
        <div class="vs-why-number">03</div>
        <h3 class="vs-why-item-title">A Focus on Energy Efficiency</h3>
        <p class="vs-why-item-desc">
          We help customers explore products that can support more efficient electricity use and reduce avoidable energy waste.
        </p>
      </div>

      <!-- Benefit 4 -->
      <div class="vs-why-item-card">
        <div class="vs-why-number">04</div>
        <h3 class="vs-why-item-title">Built Around Practical Needs</h3>
        <p class="vs-why-item-desc">
          Whether you are purchasing for your home, business, store, or larger project, we aim to make finding suitable products simpler.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ======================================================================
     Section E & F: Our Mission & Our Vision
     ====================================================================== -->
<section class="vs-mission-vision-section" id="mission-vision">
  <div class="vs-container">
    <div class="vs-mission-vision-grid">
      <!-- Section E: Our Mission -->
      <div class="vs-mv-card vs-mission-card">
        <div class="vs-mv-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
          </svg>
        </div>
        <h2 class="vs-mv-title">Our Mission</h2>
        <p class="vs-mv-desc">
          Our mission is to make energy-efficient products more accessible and encourage smarter energy use by providing practical solutions for residential, commercial, and business applications.
        </p>
      </div>

      <!-- Section F: Our Vision -->
      <div class="vs-mv-card vs-vision-card">
        <div class="vs-mv-icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </div>
        <h2 class="vs-mv-title">Our Vision</h2>
        <p class="vs-mv-desc">
          Our vision is to become a trusted destination for energy-saving and electrical products, connecting individual customers and businesses with solutions that support efficiency, innovation, and a more sustainable future.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ======================================================================
     Section G: Closing Statement & Final Tagline
     ====================================================================== -->
<section class="vs-closing-section" id="closing">
  <div class="vs-container">
    <div class="vs-closing-inner">
      <h2 class="vs-closing-title">Powering Homes. Supporting Businesses. Saving Energy.</h2>
      <p class="vs-closing-desc">
        At Vidhyut Saathi, we believe that every smart energy choice matters. Whether you are an individual customer looking for everyday solutions or a business exploring products for retail, distribution, or commercial applications, we are here to help you move toward smarter energy use.
      </p>

      <div class="vs-closing-tagline-box">
        <div class="vs-closing-tagline-text">Vidhyut Saathi – Smarter Energy Solutions for Everyone.</div>
      </div>

      <div class="vs-closing-actions">
        <a href="{{ routes.root_url }}#products" class="vs-btn vs-btn-accent">
          Explore Our Products
          <svg class="vs-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
        <a href="{{ routes.root_url }}#contact" class="vs-btn vs-btn-outline-white">
          Contact Us
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Us Page",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Page Heading",
      "default": "About Us"
    },
    {
      "type": "text",
      "id": "page_subtitle",
      "label": "Page Subtitle",
      "default": "Smarter energy choices for homes, businesses, and channel partners across India."
    }
  ],
  "presets": [
    {
      "name": "Vidhyut About Us Page"
    }
  ]
}
{% endschema %}
